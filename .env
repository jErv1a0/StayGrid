APP_ENV=prod
APP_DEBUG=1
DEFAULT_URI=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000
DATABASE_URL="mysql://root:root@127.0.0.1:3306/staygrid"

# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MESSENGER_TRANSPORT_DSN=sync://

MAILER_DSN=change-me

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=staygrid
MYSQL_USER=root
MYSQL_PASSWORD=root

APP_PORT=8080
display_errors=On
log_errors=On
error_reporting=E_ALL


###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> Google OAuth ###
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Register the callback URL that matches the host you actually open in the browser.
# For local phone testing, use an HTTPS tunnel or update Google Console to the exact host.

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-passphrase-here
