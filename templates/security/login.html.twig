<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sign In to StayGrid</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #111111;
            --paper: #f6f4ef;
            --gold: #facc15;
            --mist: #e8e5dc;
        }

        body {
            font-family: 'Manrope', sans-serif;
            background: var(--paper);
            color: var(--ink);
        }

        .display-font {
            font-family: 'Space Grotesk', sans-serif;
        }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px #ffffff inset;
        }
    </style>
</head>

<body>
<div class="min-h-screen bg-[radial-gradient(circle_at_10%_15%,rgba(250,204,21,0.24),transparent_32%),radial-gradient(circle_at_90%_85%,rgba(17,17,17,0.12),transparent_34%),linear-gradient(145deg,#f8f6f2_0%,#f0ece5_45%,#f6f4ef_100%)]">

    <header class="sticky top-0 z-20 backdrop-blur border-b border-black/10 bg-[#f6f4ef]/85">
        <div class="max-w-7xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="display-font text-xl font-bold tracking-tight">StayGrid</a>

            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-black/70">
                <a href="{{ path('app_home') }}" class="hover:text-black transition-colors">Home</a>
                <a href="{{ path('app_rooms') }}" class="hover:text-black transition-colors">Rooms</a>
                <a href="{{ path('app_about') }}" class="hover:text-black transition-colors">About</a>
                <a href="{{ path('app_contact') }}" class="hover:text-black transition-colors">Contact</a>
            </nav>

            <a href="{{ path('app_register') }}" class="inline-flex items-center px-5 py-2.5 bg-black text-white text-xs font-bold tracking-[0.2em] uppercase hover:bg-yellow-400 hover:text-black transition-colors">Create Account</a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-5 md:px-8 py-8 md:py-14">
        <section class="grid lg:grid-cols-[1.05fr_0.95fr] gap-6 lg:gap-8 min-h-[calc(100vh-9rem)]">

            <aside class="relative overflow-hidden bg-black text-white p-8 md:p-12 lg:p-14 border border-black/80">
                <div class="absolute inset-0 opacity-25" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 46px 46px;"></div>
                <div class="absolute -top-20 -right-12 w-72 h-72 rounded-full bg-yellow-400/35 blur-3xl"></div>

                <div class="relative z-10 h-full flex flex-col justify-between">
                    <div>
                        <p class="text-[11px] uppercase tracking-[0.35em] font-bold text-yellow-300 mb-8">Authentication Protocol</p>
                        <h1 class="display-font text-[clamp(2.6rem,6.2vw,5.1rem)] leading-[0.9] font-bold tracking-[-0.03em]">
                            Sign In to<br>
                            StayGrid
                        </h1>
                        <p class="mt-6 text-white/70 max-w-md leading-relaxed">
                            Access your booking dashboard, saved stays, and instant room availability from one secure entry point.
                        </p>
                    </div>

                    <div class="mt-10 grid grid-cols-3 gap-px bg-white/15 border border-white/20">
                        <div class="bg-black/65 p-4">
                            <p class="text-[10px] uppercase tracking-[0.2em] text-white/50 font-bold">Security</p>
                            <p class="mt-1 text-sm font-bold">Verified</p>
                        </div>
                        <div class="bg-black/65 p-4">
                            <p class="text-[10px] uppercase tracking-[0.2em] text-white/50 font-bold">Access</p>
                            <p class="mt-1 text-sm font-bold">Instant</p>
                        </div>
                        <div class="bg-black/65 p-4">
                            <p class="text-[10px] uppercase tracking-[0.2em] text-white/50 font-bold">Support</p>
                            <p class="mt-1 text-sm font-bold">24/7</p>
                        </div>
                    </div>
                </div>
            </aside>

            <section class="bg-white border border-black/15 p-7 md:p-10 lg:p-12 flex items-center">
                <div class="w-full max-w-xl mx-auto">
                    <div class="mb-8">
                        <p class="text-[11px] uppercase tracking-[0.28em] text-black/55 font-bold">Welcome Back</p>
                        <h2 class="display-font mt-2 text-4xl md:text-5xl leading-[0.95] font-bold tracking-tight">Initialize Session</h2>
                    </div>

                    {% if error %}
                        <div class="mb-6 p-4 border-l-4 border-red-600 bg-red-50 text-red-700 text-sm font-semibold">
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] mb-1">Auth_Error //</p>
                            <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-6 p-4 border-l-4 border-green-600 bg-green-50 text-green-700 text-sm font-semibold">
                            You are already signed in.
                        </div>
                    {% endif %}

                    <form action="{{ path('app_login') }}" method="post" class="space-y-6">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div>
                            <label for="username" class="block text-sm font-bold mb-2">Email Address</label>
                            <input id="username" name="_username" type="email" value="{{ last_username }}"
                                   required autocomplete="email" placeholder="name@domain.com"
                                   class="w-full px-4 py-4 border border-black/20 bg-white text-base font-semibold focus:outline-none focus:border-black focus:ring-0 transition-colors">
                        </div>

                        <div>
                            <label for="password" class="block text-sm font-bold mb-2">Password</label>
                            <input id="password" name="_password" type="password"
                                   required autocomplete="current-password" placeholder="Enter your password"
                                   class="w-full px-4 py-4 border border-black/20 bg-white text-base font-semibold focus:outline-none focus:border-black focus:ring-0 transition-colors">
                        </div>

                        <div class="flex items-start gap-3 border border-black/15 bg-[var(--mist)]/35 px-4 py-4">
                            <input type="checkbox" name="_remember_me" class="mt-0.5 h-4 w-4 border-black/40 text-black focus:ring-0">
                            <div>
                                <label class="text-sm font-semibold text-black/85 cursor-pointer">Keep Session Active</label>
                                <p class="text-[11px] text-black/45 mt-1">Stay signed in on this device.</p>
                            </div>
                        </div>

                        <button type="submit" class="w-full py-4 bg-black text-white text-xs font-bold tracking-[0.24em] uppercase hover:bg-yellow-400 hover:text-black transition-colors">
                            Sign In
                        </button>

                        <div class="relative flex items-center py-2">
                            <div class="w-full border-t border-black/15"></div>
                            <span class="px-3 bg-white text-[11px] uppercase tracking-[0.2em] text-black/40 font-bold">or</span>
                            <div class="w-full border-t border-black/15"></div>
                        </div>

                        <a href="{{ path('connect_google_start') }}" class="w-full inline-flex items-center justify-center gap-3 py-3.5 border border-black/20 text-black font-bold text-xs tracking-[0.14em] uppercase hover:bg-black hover:text-white transition-colors">
                            <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google logo">
                            Continue with Google
                        </a>

                        <p class="mt-6 text-sm text-center text-black/70">
                            New to the grid?
                            <a href="{{ path('app_register') }}" class="font-bold underline underline-offset-4 text-black hover:text-yellow-600">Create Account</a>
                        </p>
                    </form>
                </div>
            </section>

        </section>
    </main>
</div>
</body>
</html>
