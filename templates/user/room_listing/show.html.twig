{# templates/user/room_detail.html.twig #}
{% extends 'user/base.html.twig' %}

{% block title %}StayGrid View Stay{{ room.number|default('SPEC') }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f6f4ef] font-sans antialiased pb-24">

    {# --- NAVIGATION OVERLAY --- #}
    <div class="max-w-7xl mx-auto px-8 pt-12 pb-6 flex justify-between items-center">
        <a href="{{ path('app_user_rooms_rooms') }}"
           class="group flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 hover:text-black transition-all">
            <span class="group-hover:-translate-x-2 transition-transform">←</span> Return to Available Stays
        </a>
        <div class="text-[10px] font-mono text-gray-300 uppercase tracking-widest italic">
            Ref ID: {{ room.id|default('000') }} // Status: {{ room.isAvailable() ? 'ONLINE' : 'LOCKED' }}
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-8 grid lg:grid-cols-12 gap-16 mt-8">
        
        {# --- LEFT: VISUAL ASSET --- #}
        <div class="lg:col-span-7 space-y-8">
            <div class="aspect-[16/10] bg-gray-100 overflow-hidden relative group border border-black/10">
                {% set roomImagePath = room.image ? (room.image matches '/^uploads\\//' ? room.image : 'images/' ~ room.image) : null %}
                {% set roomCategoryKey = room.category|default('')|lower %}
                {% set roomImageFallback = 'images/default_room.png' %}
                {% if 'family' in roomCategoryKey %}
                    {% set roomImageFallback = 'images/familyapartmentFH.png' %}
                {% elseif 'executive' in roomCategoryKey or 'suite' in roomCategoryKey %}
                    {% set roomImageFallback = 'images/executivefc.png' %}
                {% elseif 'studio' in roomCategoryKey %}
                    {% set roomImageFallback = 'images/studiodeluxefh.png' %}
                {% endif %}
                 {% set room_img = roomImagePath ? asset(roomImagePath) : asset(roomImageFallback) %}
                 <img src="{{ room_img }}" 
                     class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" 
                     alt="{{ room.title }}"
                     onerror="this.onerror=null;this.src='{{ room.image ? asset('images/' ~ room.image) : asset(roomImageFallback) }}'">
                
                <div class="absolute bottom-6 left-6 bg-black text-white px-4 py-2 text-[9px] font-black uppercase tracking-[0.4em]">
                    Photo
                </div>
            </div>

            {# Optional Secondary Stats #}
            <div class="grid grid-cols-3 gap-4">
                <div class="p-6 border border-black/10 bg-white">
                    <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-2 italic">Dimension</p>
                    <p class="text-sm font-bold uppercase tracking-tighter">Premium Unit</p>
                </div>
                <div class="p-6 border border-black/10 bg-white">
                    <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-2 italic">Climate</p>
                    <p class="text-sm font-bold uppercase tracking-tighter">Active</p>
                </div>
                <div class="p-6 border border-black/10 bg-white">
                    <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-2 italic">Security</p>
                    <p class="text-sm font-bold uppercase tracking-tighter">Very Secure</p>
                </div>
            </div>
        </div>

        {# --- RIGHT: SPECIFICATIONS & AUTH --- #}
        <div class="lg:col-span-5 flex flex-col justify-center">
            <header class="mb-12">
                <div class="flex items-center gap-3 mb-4">
                    <span class="w-8 h-px bg-yellow-500"></span>
                    <span class="text-[10px] font-black uppercase tracking-[0.4em] text-yellow-600 italic">Specification Sheet</span>
                </div>
                <h1 class="text-5xl lg:text-7xl font-black tracking-tighter uppercase leading-[0.9] mb-6">
                    {{ room.title|default('Unit Untitled')|replace({'_': ' '}) }}<span class="text-gray-200">.</span>
                </h1>
                <p class="text-3xl font-black tracking-tighter italic text-gray-950">
                    ₱{{ room.pricePerNight|number_format(0) }} 
                    <span class="text-[10px] not-italic font-black text-gray-300 uppercase tracking-[0.3em] ml-2">/ Per Night</span>
                </p>
            </header>

            <div class="space-y-12 mb-16">
                <div>
                    <h2 class="text-[10px] font-black uppercase tracking-[0.5em] text-gray-400 mb-4 italic">Description</h2>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        {{ room.description|default('An impeccably designed industrial node. Featuring minimalist steel accents, high-fidelity lighting systems, and integrated spatial automation.') }}
                    </p>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="flex items-center justify-between py-3 border-b border-black/10">
                        <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 italic">Location Registry</span>
                        <span class="text-xs font-bold uppercase tracking-widest">{{ room.location|default('Manila District')|replace({'_': ' '}) }}</span>
                    </div>
                    <div class="flex items-center justify-between py-3 border-b border-black/10">
                        <span class="text-[9px] font-black uppercase tracking-widest text-gray-400 italic">Occupancy Limit</span>
                        <span class="text-xs font-bold uppercase tracking-widest">{{ room.capacity|default('2') }} Personnel</span>
                    </div>
                </div>
            </div>

            {# --- BOOKING ACTION --- #}
            <div class="pt-8 border-t border-gray-950">
                {% if room.isAvailable() and not room.isBlocked() and not room.isOccupied() %}
                    {% if app.user %}
                        <a href="{{ path('app_booking_new', {'roomId': room.id}) }}"
                           class="group flex items-center justify-between bg-gray-950 text-white px-10 py-6 text-[12px] font-black uppercase tracking-[0.5em] hover:bg-yellow-400 hover:text-black transition-all">
                            Book This Stay
                            <span class="group-hover:translate-x-2 transition-transform">→</span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}"
                           class="group flex items-center justify-between border-2 border-gray-950 px-10 py-6 text-[12px] font-black uppercase tracking-[0.5em] hover:bg-gray-950 hover:text-white transition-all">
                            Authorize to Access
                            <span class="group-hover:translate-x-2 transition-transform">→</span>
                        </a>
                    {% endif %}
                {% else %}
                    <div class="w-full bg-gray-100 text-gray-400 py-6 text-center text-[10px] font-black uppercase tracking-[0.5em] border border-gray-200 italic">
                        Currently Booked
                    </div>
                {% endif %}
                
                <p class="text-[8px] font-mono text-gray-300 uppercase mt-6 tracking-widest text-center">
                    Secure Transmission Enforced // StayGrid v2.0.6
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}