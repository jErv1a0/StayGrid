  <div class="max-w-6xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
    <div class="space-y-6">
      <h2 class="text-3xl font-extrabold text-gray-900">About StayGrid</h2>
      <p class="text-gray-600 text-lg leading-relaxed">
