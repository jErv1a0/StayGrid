<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
 
<title>{% block title %}{{ page_title|default("About StayGrid") }}{% endblock %}</title>

 
    <link rel="icon" type="image/png" href="{{ asset('icons/staygrid16x16.png') }}"/>

 
<script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Manrope', sans-serif;
        background-color: #f7f9fc;
    }
    .nav-link { color: #4b5563; }
    .nav-link:hover { color: #FFD700; }
    .btn-primary { background-color: #FFD700; border-color: #FFD700; }
    .btn-primary:hover { background-color: #e6c200; }  

     
    .feature-icon-bg { background-color: #FFF4B0; color: #FFD700; }

    {% block styles %}{% endblock %}  

</style>

</head>
<body>

{% include 'partials/_public_nav.html.twig' %}

<section class="py-20 md:py-24 bg-[#0b0c10] text-white overflow-hidden relative">
    <div class="absolute inset-0 pointer-events-none" style="background:
        radial-gradient(circle at 18% 30%, rgba(250,204,21,0.12), transparent 40%),
        radial-gradient(circle at 82% 72%, rgba(255,255,255,0.06), transparent 34%),
        linear-gradient(130deg, rgba(255,255,255,0.03), transparent 42%);"></div>
    <div class="absolute inset-0 opacity-[0.08] pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.7) 1px, transparent 1px); background-size: 72px 72px;"></div>
    <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
        <div class="absolute top-[16%] left-[8%] w-3 h-3 border border-yellow-400/60 rotate-45"></div>
        <div class="absolute top-[58%] left-[52%] w-2 h-2 bg-white/35"></div>
        <div class="absolute top-[12%] right-[10%] w-28 h-px bg-white/20"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end mb-12 lg:mb-16 lg:-mt-4">
            <div class="lg:col-span-8">
                <span class="inline-block text-[10px] font-black uppercase tracking-[0.45em] text-yellow-400 mb-4">Key Features</span>
                <h2 class="text-5xl sm:text-6xl lg:text-8xl font-black tracking-tight leading-[0.86]">
                    The Grid<br/>
                    <span class="text-transparent" style="-webkit-text-stroke: 1.5px #facc15;">Standard.</span>
                </h2>
            </div>
            <div class="lg:col-span-4">
                <p class="text-sm md:text-base text-white/70 leading-relaxed max-w-sm lg:ml-auto lg:mb-1">
                    We stripped away the noise of traditional hospitality to build a high-performance living environment.
                </p>
            </div>
        </div>

        {% set features = [
            {
                title: 'Smart Matching',
                desc: 'Neural booking systems that adapt to your travel patterns.',
                index: 'ST-01'
            },
            {
                title: 'Secure Platform',
                desc: 'Hardware-level encryption for every digital key and payment.',
                index: 'ST-02'
            },
            {
                title: '24/7 Support',
                desc: 'On-demand concierge via the Grid app, available globally.',
                index: 'ST-03'
            },
            {
                title: 'Direct Connect',
                desc: 'Zero-latency communication. No middle-men, ever.',
                index: 'ST-04'
            }
        ] %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
            {% for feature in features %}
            <article class="group relative border border-white/15 bg-white/[0.03] p-8 md:p-10 transition-all duration-500 hover:-translate-y-1 hover:border-yellow-400/70 hover:bg-yellow-400/10 overflow-hidden">
                <div class="flex items-center justify-between mb-12">
                    <span class="text-[10px] font-mono uppercase tracking-[0.28em] text-white/60 group-hover:text-yellow-300 transition-colors">
                        REF // {{ feature.index }}
                    </span>
                    <span class="w-10 h-[2px] bg-white/25 group-hover:bg-yellow-300 transition-colors"></span>
                </div>

                <h3 class="text-3xl md:text-4xl font-black uppercase tracking-tight leading-none mb-5 text-white">
                    {{ feature.title }}
                </h3>

                <p class="text-sm md:text-base text-white/70 group-hover:text-white/90 leading-relaxed transition-colors max-w-md">
                    {{ feature.desc }}
                </p>
            </article>
            {% endfor %}
        </div>

        <div class="mt-8 pt-5 border-t border-white/15 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
            <div class="flex gap-3 items-center">
                <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
                <div class="w-2 h-2 rounded-full bg-white/30"></div>
                <div class="w-2 h-2 rounded-full bg-white/30"></div>
            </div>
            <span class="text-[10px] font-bold text-white/60 uppercase tracking-widest">StayGrid Systems Inc. &copy; 2026</span>
        </div>
    </div>
</section>

