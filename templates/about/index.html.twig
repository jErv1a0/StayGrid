<section class="py-32 bg-gray-900 text-white overflow-hidden border-t border-yellow-400">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="grid lg:grid-cols-12 gap-0 border border-white/10">
            
            <div class="lg:col-span-5 p-10 lg:p-16 border-b lg:border-b-0 lg:border-r border-white/10 bg-gray-950 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-12">
                        <div class="w-3 h-3 bg-yellow-400 rotate-45"></div>
                        <span class="text-[10px] font-black uppercase tracking-[0.5em] text-gray-500">Core_Directive // 01</span>
                    </div>
                    
                    <h2 class="text-6xl lg:text-7xl font-black text-white tracking-tighter leading-[0.85] mb-12">
                        Our<br/>
                        Mission<br/>
                        <span class="text-transparent" style="-webkit-text-stroke: 1px #facc15;">& Values.</span>
                    </h2>
                </div>

                <div class="space-y-6">
                    <p class="text-xl font-medium leading-snug text-gray-300">
                        StayGrid exists to deliver <span class="text-white italic underline decoration-yellow-400 underline-offset-4">asymmetric value</span> through high-performance hospitality infrastructure.
                    </p>
                    <p class="text-xs text-gray-500 font-mono leading-relaxed max-w-sm uppercase tracking-widest">
                        We believe in people-first design - ensuring our technology empowers rather than complicates.
                    </p>
                </div>
            </div>

            <div class="lg:col-span-7 grid grid-cols-1">
                
                {% set values = [
                    { 
                        'id': '01', 
                        'title': 'Innovation', 
                        'desc': 'We continuously iterate on our platform to meet modern hospitality standards. Stagnation is a system failure.' 
                    },
                    { 
                        'id': '02', 
                        'title': 'Integrity', 
                        'desc': 'Transparency and radical honesty guide every interaction. We prioritize the protocol over the person.' 
                    },
                    { 
                        'id': '03', 
                        'title': 'Service', 
                        'desc': 'Customer satisfaction is our North Star. We solve problems at zero-latency to ensure an uninterrupted experience.' 
                    }
                ] %}

                {% for value in values %}
                <div class="group relative p-10 lg:p-16 border-b last:border-b-0 border-white/10 hover:bg-yellow-400 transition-all duration-700 cursor-default">
                    <div class="flex items-start justify-between relative z-10">
                        <div class="max-w-md">
                            <span class="text-[10px] font-mono text-yellow-400 group-hover:text-gray-900 transition-colors mb-4 block uppercase tracking-widest">Protocol_{{ value.id }}</span>
                            <h3 class="text-4xl font-black text-white group-hover:text-gray-900 uppercase tracking-tighter mb-4 transition-colors">
                                {{ value.title }}
                            </h3>
                            <p class="text-gray-400 group-hover:text-gray-800 font-medium leading-relaxed transition-colors">
                                {{ value.desc }}
                            </p>
                        </div>
                        
                        <span class="text-8xl font-black text-white/5 group-hover:text-gray-900/10 transition-colors pointer-events-none select-none">
                            {{ value.id }}
                        </span>
                    </div>

                    <div class="absolute bottom-0 left-0 w-0 h-1 bg-gray-900 group-hover:w-full transition-all duration-700"></div>
                </div>
                {% endfor %}

            </div>
        </div>

        <div class="mt-8 flex justify-between items-center opacity-30">
            <div class="text-[10px] font-mono uppercase tracking-[0.5em]">System_Verified: 2026</div>
            <div class="flex gap-4">
                <div class="w-12 h-[1px] bg-white"></div>
                <div class="w-4 h-[1px] bg-yellow-400"></div>
            </div>
        </div>
    </div>
</section>

<section class="relative py-32 bg-white overflow-hidden border-t border-gray-900">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-12 gap-0 border border-gray-900">
            
            <div class="lg:col-span-5 relative bg-gray-50 flex items-center justify-center p-12 lg:p-20 border-b lg:border-b-0 lg:border-r border-gray-900 overflow-hidden group">
                <div class="relative w-full aspect-square border border-gray-900 p-2 bg-white transition-transform duration-700 group-hover:-rotate-1">
                    <div class="w-full h-full overflow-hidden relative">
                        <img src="{{ asset('images/developer.jpg') }}" alt="Jervine Alvarico"
                             class="w-full h-full object-cover grayscale transition-all duration-1000 group-hover:grayscale-0 group-hover:scale-110">
                        
                        <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-yellow-400"></div>
                        <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-yellow-400"></div>
                    </div>
                </div>

                <div class="absolute bottom-10 right-10 bg-gray-900 text-yellow-400 px-6 py-3 shadow-[8px_8px_0px_0px_#facc15] flex items-center gap-3">
                    <i data-feather="check-circle" class="w-4 h-4"></i>
                    <span class="text-[10px] font-black uppercase tracking-widest">Identity_Verified</span>
                </div>
            </div>

            <div class="lg:col-span-7 p-10 lg:p-20 flex flex-col justify-center bg-white">
                <div class="mb-12">
                    <span class="text-[10px] font-black uppercase tracking-[0.5em] text-yellow-500 mb-4 block">Lead</span>
                    <h2 class="text-6xl lg:text-7xl font-black text-gray-900 tracking-tighter leading-none mb-4 uppercase">
                        Jervine <br/>
                        <span class="text-transparent" style="-webkit-text-stroke: 1.5px #111827;">Alvarico.</span>
                    </h2>
                    <p class="text-gray-400 font-mono text-xs uppercase tracking-widest">Developer & Founder</p>
                </div>

                <div class="max-w-xl">
                    <div class="relative pl-8 border-l-2 border-yellow-400 mb-10">
                        <p class="text-xl font-bold text-gray-900 leading-tight mb-6 italic">
                            "StayGrid is the synthesis of high-performance logic and human-centric design."
                        </p>
                        <p class="text-gray-500 leading-relaxed font-medium">
                            Dedicated to revolutionizing the hospitality industry through modular technology - building secure, smart, and intuitive systems that empower property management at scale.
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-10 pt-10 border-t border-gray-100">
                        <div>
                            <p class="text-[10px] font-black text-gray-300 uppercase mb-2">Primary_Stack</p>
                            <p class="text-xs font-bold text-gray-900 uppercase tracking-widest">PHP 8.x</p>
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-gray-300 uppercase mb-2">Professional_Network</p>
                            <a href="https://www.linkedin.com/in/jervine-alvarico-44b8a7255/" target="_blank" 
                               class="text-xs font-black text-gray-900 uppercase tracking-widest hover:text-yellow-500 flex items-center gap-2 transition-colors">
                                LinkedIn <i data-feather="external-link" class="w-3 h-3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-0 border border-t-0 border-gray-900 bg-gray-50 p-10 lg:p-16">
            <div class="flex items-end justify-between mb-10 gap-6">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-[0.5em] text-yellow-500 mb-3 block">Core Team</span>
                    <h3 class="text-3xl lg:text-4xl font-black text-gray-900 tracking-tighter uppercase leading-none">Meet the Team</h3>
                    <p class="mt-3 text-xs font-bold text-gray-500 uppercase tracking-widest">Built by Specialists.</p>
                </div>
                <p class="hidden lg:block text-[10px] font-mono text-gray-400 uppercase tracking-widest">Added_Profiles: 2</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <article class="border border-gray-900 bg-white p-6 lg:p-8 group">
                    <div class="flex items-start gap-5">
                        <div class="w-20 h-20 border border-gray-900 p-1 shrink-0">
                            <img src="https://i.pravatar.cc/300?img=12" alt="Developer profile"
                                 class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" referrerpolicy="no-referrer">
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-yellow-600 uppercase tracking-widest mb-2">Developer</p>
                            <h4 class="text-xl font-black text-gray-900 uppercase tracking-tighter">Nico Ramirez</h4>
                            <p class="text-xs text-gray-500 font-medium mt-3 leading-relaxed">Builds reliable backend flows and production-ready features with clean, testable architecture.</p>
                        </div>
                    </div>
                </article>

                <article class="border border-gray-900 bg-white p-6 lg:p-8 group">
                    <div class="flex items-start gap-5">
                        <div class="w-20 h-20 border border-gray-900 p-1 shrink-0">
                            <img src="https://i.pravatar.cc/300?img=47" alt="UI UX Designer profile"
                                 class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" referrerpolicy="no-referrer">
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-yellow-600 uppercase tracking-widest mb-2">UI / UX Designer</p>
                            <h4 class="text-xl font-black text-gray-900 uppercase tracking-tighter">Mia Laurent</h4>
                            <p class="text-xs text-gray-500 font-medium mt-3 leading-relaxed">Designs intuitive interfaces and polished user journeys that keep digital experiences clear and engaging.</p>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section x-data="{ activeSlide: 1, totalSlides: {{ 5 + feedbacks|length }} }" 
         x-init="setInterval(() => activeSlide = activeSlide === totalSlides ? 1 : activeSlide + 1, 6000)"
         class="relative py-32 bg-white border-t border-gray-900 overflow-hidden">
    
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="flex flex-col lg:flex-row justify-between items-baseline mb-24 gap-6">
            <div class="max-w-2xl">
                <span class="text-[10px] font-black uppercase tracking-[0.5em] text-yellow-500 mb-4 block">Validation // Feedback</span>
                <h2 class="text-6xl lg:text-7xl font-black text-gray-900 tracking-tighter leading-none uppercase">
                    Trusted by the <br/>
                    <span class="text-transparent" style="-webkit-text-stroke: 1.5px #111827;">Network.</span>
                </h2>
            </div>
            <div class="hidden lg:block">
                <p class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">Active_Sessions: {{ 5 + feedbacks|length }}</p>
            </div>
        </div>

        <div class="relative min-h-[450px] border border-gray-900 bg-gray-50">
            
            <div class="absolute top-0 left-0 w-20 h-full border-r border-gray-900 bg-white hidden lg:flex flex-col items-center py-10 gap-8">
                <div class="w-1 h-20 bg-yellow-400"></div>
                <span class="[writing-mode:vertical-lr] rotate-180 text-[10px] font-black uppercase tracking-[0.3em] text-gray-300">USER_LOG_DATA</span>
            </div>

            <div class="lg:ml-20 relative">
                
                {% set static_clients = [
                    {'name': 'Jas Pineda', 'role': 'Marketing Executive', 'img': 'Jas Pineda.jpg', 'quote': 'StayGrid made our family vacation smooth and enjoyable. The booking process was fast, and the rooms were beyond expectations!'},
                    {'name': 'Jim Ashley', 'role': 'Entrepreneur', 'img': 'JimAshley.jpg', 'quote': 'I loved the smart booking feature! StayGrid feels like the future of hotel stays. Everything was efficient and seamless.'},
                    {'name': 'Ryza Mahinay', 'role': 'Tech Startup Founder', 'img': 'Rhyza.jpg', 'quote': 'StayGrids secure and smart system gave me peace of mind. Its clear that innovation drives everything they do.'},
                    {'name': 'Demi Jane', 'role': 'Frequent Traveler', 'img': 'DemiJane.jpg', 'quote': 'The comfort and attention to detail in StayGrid properties are unmatched. Definitely my go-to booking platform now.'},
                    {'name': 'Jasmine Armentano', 'role': 'Hotel Owner Partner', 'img': 'Jasmine.jpg', 'quote': 'Partnering with StayGrid has elevated our guest experience and increased our bookings. Their platform is top-notch.'}
                ] %}

                {% for client in static_clients %}
                <div x-show="activeSlide === {{ loop.index }}" 
                     x-transition:enter="transition ease-out duration-500"
                     x-transition:enter-start="opacity-0 translate-x-8"
                     x-transition:enter-end="opacity-100 translate-x-0"
                     class="flex flex-col lg:flex-row items-stretch min-h-[450px]">
                    
                    <div class="lg:w-1/3 p-10 lg:p-16 border-b lg:border-b-0 lg:border-r border-gray-900 bg-white flex flex-col justify-center items-center text-center">
                        <div class="relative w-32 h-32 mb-8 border border-gray-900 p-1">
                            <img src="{{ asset('images/' ~ client.img) }}" class="w-full h-full object-cover grayscale">
                            <div class="absolute -top-2 -right-2 w-6 h-6 bg-yellow-400 flex items-center justify-center border border-gray-900">
                                <i data-feather="quote" class="w-3 h-3 text-gray-900"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 uppercase tracking-tighter">{{ client.name }}</h3>
                        <p class="text-[10px] font-bold text-yellow-600 uppercase tracking-widest mt-2">{{ client.role }}</p>
                    </div>

                    <div class="lg:w-2/3 p-10 lg:p-20 flex flex-col justify-center relative bg-gray-50">
                        <span class="text-6xl font-black text-gray-200 absolute top-10 left-10 select-none">&ldquo;</span>
                        <p class="text-2xl lg:text-3xl font-bold text-gray-900 leading-tight relative z-10 italic">
                            {{ client.quote }}
                        </p>
                        <div class="mt-12 flex items-center gap-4">
                            <div class="h-px w-12 bg-gray-900"></div>
                            <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest italic">Verification: AUTH_0{{ loop.index }}_STAYGRID</span>
                        </div>
                    </div>
                </div>
                {% endfor %}

                {% for feedback in feedbacks %}
                <div x-show="activeSlide === {{ 5 + loop.index }}" 
                     x-transition:enter="transition ease-out duration-500"
                     x-transition:enter-start="opacity-0 translate-x-8"
                     x-transition:enter-end="opacity-100 translate-x-0"
                     class="flex flex-col lg:flex-row items-stretch min-h-[450px]">
                    
                    <div class="lg:w-1/3 p-10 lg:p-16 border-b lg:border-b-0 lg:border-r border-gray-900 bg-white flex flex-col justify-center items-center text-center">
                        <div class="relative w-32 h-32 mb-8 border border-gray-900 p-1">
                            <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                                <span class="text-4xl font-black text-gray-300">{{ feedback.name|slice(0,1)|upper }}</span>
                            </div>
                            <div class="absolute -top-2 -right-2 w-6 h-6 bg-yellow-400 flex items-center justify-center border border-gray-900">
                                <i data-feather="quote" class="w-3 h-3 text-gray-900"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 uppercase tracking-tighter">{{ feedback.name }}</h3>
                        <p class="text-[10px] font-bold text-yellow-600 uppercase tracking-widest mt-2">Verified Guest</p>
                    </div>

                    <div class="lg:w-2/3 p-10 lg:p-20 flex flex-col justify-center relative bg-gray-50">
                        <span class="text-6xl font-black text-gray-200 absolute top-10 left-10 select-none">&ldquo;</span>
                        <p class="text-2xl lg:text-3xl font-bold text-gray-900 leading-tight relative z-10 italic">
                            {{ feedback.content }}
                        </p>
                        <div class="mt-12 flex items-center gap-4">
                            <div class="h-px w-12 bg-gray-900"></div>
                            <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest italic">Date: {{ feedback.createdAt|date('M d, Y') }}</span>
                        </div>
                    </div>
                </div>
                {% endfor %}

                </div>
        </div>

        <div class="mt-12 flex items-center justify-between">
            <div class="flex gap-4">
                <template x-for="i in totalSlides">
                    <button @click="activeSlide = i" 
                            class="h-1 transition-all duration-500"
                            :class="activeSlide === i ? 'w-12 bg-gray-900' : 'w-4 bg-gray-200 hover:bg-gray-400'"></button>
                </template>
            </div>
            
            <div class="flex gap-2">
                <button @click="activeSlide = activeSlide === 1 ? totalSlides : activeSlide - 1" class="w-10 h-10 border border-gray-900 flex items-center justify-center hover:bg-gray-900 hover:text-white transition-all">
                    <i data-feather="chevron-left" class="w-4"></i>
                </button>
                <button @click="activeSlide = activeSlide === totalSlides ? 1 : activeSlide + 1" class="w-10 h-10 border border-gray-900 flex items-center justify-center hover:bg-gray-900 hover:text-white transition-all">
                    <i data-feather="chevron-right" class="w-4"></i>
                </button>
            </div>
        </div>

    </div>
</section>

<!-- Alpine.js (for slider animation) -->
<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>


<main>
{% block content %}{% endblock %}
<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="text-xl font-bold mb-4">StayGrid</h3>
        <p class="text-gray-400">Your trusted accommodation partner for unforgettable stays.</p>
      </div>
      <div>
