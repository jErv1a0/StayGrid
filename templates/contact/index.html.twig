<!DOCTYPE html>

<html lang="en">
<head>
  {% include 'partials/_global_radius.html.twig' %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ page_title|default("Contact StayGrid") }}{% endblock %}</title>


    <link rel="icon" type="image/png" href="{{ asset('icons/staygrid16x16.png') }}"/>


<script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Manrope', sans-serif;
        background-color: #f7f9fc;
    }
    .nav-link { color: #4b5563; }
    .nav-link:hover { color: #FFD700; }
    .btn-primary { background-color: #FFD700; border-color: #FFD700; }
    .btn-primary:hover { background-color: #e6c200; } 
 
    .feature-icon-bg { background-color: #FFF4B0; color: #FFD700; }

    {% block styles %}{% endblock %} 

</style>

</head>
<body>



{% include 'partials/_public_nav.html.twig' %}

{% for message in app.flashes('success') %}
<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
  <span class="block sm:inline">{{ message }}</span>
</div>
{% endfor %}

<section class="relative bg-[#0b0c10] text-white overflow-hidden border-b border-white/15">
  <div class="absolute inset-0 pointer-events-none" style="background:
    radial-gradient(circle at 14% 28%, rgba(250,204,21,0.12), transparent 38%),
    radial-gradient(circle at 86% 74%, rgba(255,255,255,0.08), transparent 32%),
    linear-gradient(130deg, rgba(255,255,255,0.04), transparent 42%);"></div>
  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.7) 1px, transparent 1px); background-size: 70px 70px;"></div>

  <div class="grid grid-cols-1 lg:grid-cols-2 items-stretch relative z-10">
  <div class="p-10 md:p-16 lg:p-20 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-white/15">
    <div class="inline-flex items-center gap-3 mb-8">
    <span class="w-12 h-px bg-yellow-400"></span>
    <span class="text-[10px] font-black uppercase tracking-[0.45em] text-yellow-400">Contact StayGrid</span>
    </div>

    <h1 class="text-5xl md:text-7xl font-black mb-8 tracking-[-0.04em] uppercase leading-[0.84]">
    Contact <br/>
    <span class="text-transparent" style="-webkit-text-stroke: 1.5px #facc15;">Us Today.</span>
    </h1>

    <p class="text-white/70 text-lg md:text-xl font-medium leading-tight max-w-lg">
    StayGrid support systems are active. Reach out for booking synchronization or technical stay assistance.
    </p>
  </div>

  <div class="relative h-[22rem] lg:h-full">
    <img src="{{ asset('images/banner.png') }}" alt="Contact StayGrid" class="object-cover w-full h-full">
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/15 to-black/55 pointer-events-none"></div>
  </div>
  </div>
</section>

<section class="py-20 md:py-24 bg-[#f8f8f6]">
  <div class="max-w-7xl mx-auto px-6">

<div class="grid grid-cols-1 lg:grid-cols-12 gap-y-14 lg:gap-x-16 mb-24 items-start">

  <div class="lg:col-span-5 flex flex-col pt-2">
    <div class="inline-flex items-center gap-3 mb-10">
      <span class="w-12 h-[2px] bg-yellow-500"></span>
      <span class="text-[10px] font-black uppercase tracking-[0.45em] text-gray-500">Communication Log</span>
    </div>

    <h2 class="text-5xl md:text-7xl font-black text-gray-900 uppercase tracking-[-0.04em] leading-[0.84] mb-8">
      Tell Us <br/>
      <span class="text-transparent" style="-webkit-text-stroke: 1.4px #111827;">Everything.</span>
    </h2>

    <p class="text-gray-600 text-lg font-medium leading-snug max-w-sm mb-10">
      Direct interface for guest feedback. Every word is processed by the StayGrid optimization core.
    </p>

    <div class="mt-auto p-5 border border-gray-300 bg-white/80">
      <p class="text-[9px] font-mono text-gray-500 uppercase tracking-widest leading-relaxed">
        STATUS: RECEIVING_DATA<br>
        VISIBILITY: PUBLIC_ABOUT_PAGE<br>
        PRIORITY: ALPHA_ONE
      </p>
    </div>
  </div>

  <div class="lg:col-span-7">
    <form action="{{ path('app_contact') }}" method="POST" class="space-y-10 border border-gray-300 bg-white p-7 md:p-10 lg:p-12 shadow-[0_20px_70px_rgba(17,24,39,0.08)]">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10">
        <div class="group relative">
          <label for="feedback_name" class="block text-[10px] font-black uppercase tracking-widest text-yellow-600 mb-3 transition-colors group-focus-within:text-gray-900">
            01 // Guest_Identity
          </label>
          <input type="text" id="feedback_name" name="feedback_name" required
               placeholder="YOUR FULL NAME"
               class="w-full bg-transparent border border-gray-300 focus:border-gray-900 focus:outline-none text-lg md:text-xl font-extrabold tracking-tight placeholder:text-gray-300 transition-all px-4 py-4">
        </div>

        <div class="group relative">
          <label for="feedback_email" class="block text-[10px] font-black uppercase tracking-widest text-yellow-600 mb-3 transition-colors group-focus-within:text-gray-900">
            02 // Digital_Address
          </label>
          <input type="email" id="feedback_email" name="feedback_email" required
               placeholder="EMAIL@HOST.COM"
               class="w-full bg-transparent border border-gray-300 focus:border-gray-900 focus:outline-none text-lg md:text-xl font-extrabold tracking-tight placeholder:text-gray-300 transition-all px-4 py-4">
        </div>
      </div>

      <div class="group relative">
        <label for="feedback" class="block text-[10px] font-black uppercase tracking-widest text-yellow-600 mb-3 transition-colors group-focus-within:text-gray-900">
          03 // User Feedback
        </label>
        <textarea id="feedback" name="feedback" rows="5" required
              placeholder="ENTER LOG DATA: FEEDBACK, SUGGESTIONS, OR PROTOCOL ERRORS..."
              class="w-full bg-transparent border border-gray-300 focus:border-gray-900 focus:outline-none text-base md:text-xl font-extrabold tracking-tight placeholder:text-gray-300 transition-all px-4 py-4 resize-none leading-snug"></textarea>
      </div>

      <div class="flex flex-col xl:flex-row xl:items-center gap-5 pt-2">
        <button type="submit"
            class="group relative inline-flex items-center justify-center gap-5 bg-gray-900 text-white px-10 py-5 overflow-hidden transition-all hover:bg-yellow-400 hover:text-gray-900">
          <span class="relative z-10 font-black uppercase tracking-[0.28em] text-xs">Submit</span>
          <i data-feather="arrow-right" class="w-5 h-5 group-hover:translate-x-1.5 transition-transform"></i>
        </button>

        <a href="https://forms.gle/Z7uPhsr6zH8MmV9d9" target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-3 bg-yellow-400 text-gray-900 px-8 py-5 uppercase font-black tracking-[0.28em] text-xs hover:bg-yellow-500 transition-all">
          Gforms Feedback
        </a>

        <div class="max-w-[260px]">
          <p class="text-[10px] font-mono text-gray-500 uppercase leading-relaxed tracking-tight italic">
            By clicking Execute, you authorize the data sync to StayGrid servers.
          </p>
        </div>
      </div>
    </form>
  </div>
</div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-l border-gray-900">
      
      <div class="group p-12 border-r border-b border-gray-900 hover:bg-gray-950 transition-all duration-500">
        <div class="text-yellow-500 mb-8 group-hover:scale-110 transition-transform">
          <i data-feather="share-2" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-black uppercase tracking-tighter mb-4 group-hover:text-white">Social_Media</h3>
        <p class="text-gray-500 group-hover:text-gray-400 font-mono text-sm leading-loose">
            INSTA: @StayGrid<br>
            FB: /StayGridHomes
        </p>
      </div>

      <div class="group p-12 border-r border-b border-gray-900 hover:bg-gray-950 transition-all duration-500">
        <div class="text-yellow-500 mb-8 group-hover:scale-110 transition-transform">
          <i data-feather="mail" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-black uppercase tracking-tighter mb-4 group-hover:text-white">Email_Link</h3>
        <p class="text-gray-500 group-hover:text-gray-400 font-mono text-sm leading-loose">
            staygridofficial@corps.com
        </p>
      </div>

      <div class="group p-12 border-r border-b border-gray-900 hover:bg-gray-950 transition-all duration-500">
        <div class="text-yellow-500 mb-8 group-hover:scale-110 transition-transform">
          <i data-feather="map-pin" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-black uppercase tracking-tighter mb-4 group-hover:text-white">HQ_Location</h3>
        <p class="text-gray-500 group-hover:text-gray-400 font-mono text-sm leading-loose">
            Cervantes St., StayGrid Bldg.<br>
            Dumaguete City, 6200
        </p>
      </div>

    </div>
  </div>
</section>

<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="text-xl font-bold mb-4">StayGrid</h3>
        <p class="text-gray-400">Your trusted accommodation partner for unforgettable stays.</p>
      </div>
      <div>
        <h4 class="font-bold text-yellow-400 mb-4">Navigation</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/" class="hover:text-yellow-400 transition">Home</a></li>
          <li><a href="/rooms" class="hover:text-yellow-400 transition">Rooms</a></li>
          <li><a href="/about" class="hover:text-yellow-400 transition">About Us</a></li>
          <li><a href="/contact" class="hover:text-yellow-400 transition">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-yellow-400 mb-4">Support</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="#" class="hover:text-yellow-400 transition">FAQ</a></li>
          <li><a href="#" class="hover:text-yellow-400 transition">Booking Help</a></li>
          <li><a href="#" class="hover:text-yellow-400 transition">Cancellation Policy</a></li>
          <li><a href="#" class="hover:text-yellow-400 transition">Privacy</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-yellow-400 mb-4">Contact</h4>
        <p class="text-gray-400 mb-2">Email: <a href="mailto:info@staygrid.com" class="hover:text-yellow-400 transition">info@staygrid.com</a></p>
        <p class="text-gray-400">Phone: <a href="tel:+15551234567" class="hover:text-yellow-400 transition">+1 (555) 123-4567</a></p>
      </div>
    </div>
    <div class="border-t border-gray-700 pt-8 text-center text-gray-500">
      <p>&copy; 2026 StayGrid. All rights reserved.</p>
    </div>
  </div>
</footer>
</main>


</body>
</html>
