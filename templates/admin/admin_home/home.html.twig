{% extends 'admin/base.html.twig' %}

{% block title %}StayGrid // System_Core{% endblock %}

{% block body %}
<div class="space-y-8">

    <section class="relative overflow-hidden border border-black/10 bg-[#0b0c10] text-white p-7 md:p-9">
        <div class="absolute inset-0 pointer-events-none" style="background:
            radial-gradient(circle at 15% 24%, rgba(250,204,21,0.16), transparent 36%),
            radial-gradient(circle at 82% 70%, rgba(255,255,255,0.08), transparent 32%);"></div>
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2 py-0.5 bg-yellow-400 text-black text-[9px] font-black uppercase tracking-widest">Master View</span>
                    <span class="text-[9px] font-mono text-white/60 uppercase tracking-widest">Last Sync: {{ "now"|date("H:i:s") }}</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight">System Overview.</h1>
            </div>
            <div class="w-full lg:w-auto border border-white/20 bg-black/35 px-6 py-4">
                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-white/60 mb-1">System Time</p>
                <div id="real-time-clock" class="font-mono leading-tight"></div>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <article class="border border-black/10 bg-white p-5">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Total Units</p>
            <p class="text-4xl font-black text-gray-950 mt-2">{{ total_rooms }}</p>
        </article>
        <article class="border border-black/10 bg-white p-5">
            <p class="text-[10px] font-black text-green-700 uppercase tracking-widest">Available</p>
            <p class="text-4xl font-black text-gray-950 mt-2">{{ available_rooms }}</p>
        </article>
        <article class="border border-black/10 bg-white p-5">
            <p class="text-[10px] font-black text-red-700 uppercase tracking-widest">Occupied</p>
            <p class="text-4xl font-black text-gray-950 mt-2">{{ occupied_rooms }}</p>
        </article>
        <article class="border border-black/10 bg-[#111827] text-white p-5">
            <p class="text-[10px] font-black text-yellow-400 uppercase tracking-widest">Gross Rev</p>
            <p class="text-3xl font-black mt-2">₱{{ total_revenue|number_format(0) }}</p>
        </article>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <article class="border border-black/10 bg-white p-6 xl:col-span-2">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-[11px] font-black uppercase tracking-[0.25em]">Revenue Trend</h2>
                <span class="text-[9px] font-mono uppercase text-gray-400">Last 6 Months</span>
            </div>
            <div class="h-72">
                <canvas id="admin-revenue-chart"></canvas>
            </div>
        </article>

        <article class="border border-black/10 bg-white p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-[11px] font-black uppercase tracking-[0.25em]">Booking Status</h2>
                <span class="text-[9px] font-mono uppercase text-gray-400">Distribution</span>
            </div>
            <div class="h-72">
                <canvas id="admin-booking-status-chart"></canvas>
            </div>
        </article>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <article class="border border-black/10 bg-white p-6 xl:col-span-2">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-[11px] font-black uppercase tracking-[0.25em]">Booking Volume</h2>
                <span class="text-[9px] font-mono uppercase text-gray-400">Monthly Count</span>
            </div>
            <div class="h-64">
                <canvas id="admin-booking-volume-chart"></canvas>
            </div>
        </article>

        <article class="border border-black/10 bg-white p-6">
            <h2 class="text-[11px] font-black uppercase tracking-[0.25em] mb-4">Report Snapshot</h2>
            <div class="space-y-3 text-[11px]">
                <div class="border border-gray-200 p-3 flex justify-between">
                    <span class="font-black uppercase text-gray-500 text-[9px]">Confirmed</span>
                    <span class="font-black text-green-700">{{ booking_status_counts.confirmed }}</span>
                </div>
                <div class="border border-gray-200 p-3 flex justify-between">
                    <span class="font-black uppercase text-gray-500 text-[9px]">Pending</span>
                    <span class="font-black text-yellow-700">{{ booking_status_counts.pending }}</span>
                </div>
                <div class="border border-gray-200 p-3 flex justify-between">
                    <span class="font-black uppercase text-gray-500 text-[9px]">Cancelled</span>
                    <span class="font-black text-red-600">{{ booking_status_counts.cancelled }}</span>
                </div>
                <div class="border border-gray-200 p-3 flex justify-between">
                    <span class="font-black uppercase text-gray-500 text-[9px]">Rejected</span>
                    <span class="font-black text-orange-600">{{ booking_status_counts.rejected }}</span>
                </div>
            </div>
        </article>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        
        <div class="lg:col-span-2 space-y-12">
            
            {# Room Inventory Console #}
            <section>
                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-xs font-black uppercase tracking-[0.3em] flex items-center gap-3">
                        <span class="w-8 h-[2px] bg-yellow-400"></span> Room Inventory Stream
                    </h2>
                    <a href="{{ path('app_admin_roomlisting_index') }}" class="text-[10px] font-bold uppercase border-b-2 border-gray-950 hover:text-yellow-600 transition-all">Manage All</a>
                </div>

                <div class="border border-black/10 bg-white overflow-hidden">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-[#111827] text-white text-[9px] font-black uppercase tracking-widest">
                            <tr>
                                <th class="px-6 py-3">Node_ID</th>
                                <th class="px-6 py-3">Unit_Num</th>
                                <th class="px-6 py-3">Class</th>
                                <th class="px-6 py-3 text-right">Status_Code</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-black/10">
                            {% for room in rooms|slice(0, 5) %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 font-mono text-[11px] text-gray-400">#{{ room.id }}</td>
                                    <td class="px-6 py-4 font-black text-sm uppercase">{{ room.number }}</td>
                                    <td class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-tighter">{{ room.category ?: 'Standard' }}</td>
                                    <td class="px-6 py-4 text-right">
                                        {% if room.id in occupied_room_ids %} 
                                            <span class="inline-block bg-red-100 text-red-700 text-[9px] font-black px-2 py-1 uppercase">Occupied</span>
                                        {% else %}
                                            <span class="inline-block bg-green-100 text-green-700 text-[9px] font-black px-2 py-1 uppercase">Ready</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            {# Transaction History Stream #}
            <section>
                <h2 class="text-xs font-black uppercase tracking-[0.3em] flex items-center gap-3 mb-5">
                    <span class="w-8 h-[2px] bg-gray-950"></span> Revenue Transactions
                </h2>
                <div class="border border-black/10 bg-white overflow-hidden">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-[#f8f8f6] border-b border-black/10 text-[9px] font-black uppercase tracking-widest text-gray-400">
                            <tr>
                                <th class="px-6 py-3 text-gray-950">Ref_ID</th>
                                <th class="px-6 py-3">User_Node</th>
                                <th class="px-6 py-3">Value</th>
                                <th class="px-6 py-3 text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-black/10">
                            {% for transaction in transactions|slice(0, 5) %}
                                <tr class="text-[11px]">
                                    <td class="px-6 py-4 font-mono text-gray-400">TX_{{ transaction.id }}</td>
                                    <td class="px-6 py-4 font-bold uppercase truncate max-w-[120px]">{{ transaction.user.email|split('@')|first }}...</td>
                                    <td class="px-6 py-4 font-black text-green-600">₱{{ transaction.amount|number_format(0) }}</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-gray-400 uppercase">{{ transaction.status }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="space-y-10">
            
            {# Occupancy Monitor #}
            <div class="bg-gray-950 text-white p-8 shadow-[10px_10px_0px_0px_rgba(250,204,21,1)]">
                <h2 class="text-[11px] font-black uppercase tracking-[0.3em] mb-8 flex items-center justify-between">
                    Category Load <i data-feather="bar-chart-2" class="w-4 h-4 text-yellow-400"></i>
                </h2>

                <div class="space-y-8">
                    {% for category, stats in room_category_stats %}
                        {% if stats.total > 0 %}
                            {% set occupied_percent = (stats.occupied / stats.total) * 100 %}
                            <div class="space-y-2">
                                <div class="flex justify-between text-[10px] font-mono uppercase">
                                    <span class="text-gray-400">{{ category }}</span>
                                    <span class="text-yellow-400">{{ stats.occupied }}/{{ stats.total }}</span>
                                </div>
                                <div class="h-1.5 bg-white/10 w-full">
                                    <div class="h-full bg-yellow-400 transition-all duration-1000" style="width: {{ occupied_percent }}%"></div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {# User Count Card #}
            <div class="border border-black/10 bg-white p-8 flex items-center justify-between group hover:bg-gray-50 transition-colors">
                <div>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Active Profiles</p>
                    <p class="text-5xl font-black text-gray-950">{{ active_user_count }}</p>
                </div>
                <div class="w-16 h-16 bg-gray-950 text-yellow-400 flex items-center justify-center rotate-3 group-hover:rotate-0 transition-transform">
                    <i data-feather="users" class="w-8 h-8"></i>
                </div>
            </div>

            {# Quick Actions Console #}
            <div class="bg-yellow-400 border border-black p-6">
                <p class="text-[10px] font-black text-black uppercase tracking-widest mb-4">Quick Directives</p>
                <div class="grid grid-cols-1 gap-2">
                    <a href="{{ path('app_admin_users_index') }}" class="bg-black text-white text-[10px] font-black uppercase py-3 px-4 flex justify-between items-center hover:bg-gray-800 transition-colors">
                        User Directory <i data-feather="arrow-right" class="w-3 h-3"></i>
                    </a>
                    <a href="{{ path('app_admin_activity_logs_index') }}" class="bg-black text-white text-[10px] font-black uppercase py-3 px-4 flex justify-between items-center hover:bg-gray-800 transition-colors">
                        Security Audit <i data-feather="arrow-right" class="w-3 h-3"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const dateStr = now.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();

            const el = document.getElementById('real-time-clock');
            if (el) {
                el.innerHTML = `
                    <div class="text-4xl font-black text-white tracking-tighter">${timeStr}</div>
                    <div class="text-[10px] font-bold text-yellow-600 tracking-widest mt-1">${dateStr}</div>
                `;
            }
        }
        setInterval(updateClock, 1000);
        updateClock();

        const adminLabels = {{ monthly_labels|json_encode|raw }};
        const adminRevenueData = {{ monthly_revenue_data|json_encode|raw }};
        const adminBookingVolumeData = {{ monthly_booking_data|json_encode|raw }};
        const adminStatusData = {{ [booking_status_counts.confirmed, booking_status_counts.pending, booking_status_counts.cancelled, booking_status_counts.rejected, booking_status_counts.other]|json_encode|raw }};

        const revenueCtx = document.getElementById('admin-revenue-chart');
        if (revenueCtx) {
            new Chart(revenueCtx, {
                type: 'line',
                data: {
                    labels: adminLabels,
                    datasets: [{
                        label: 'Revenue',
                        data: adminRevenueData,
                        borderColor: '#111827',
                        backgroundColor: 'rgba(250, 204, 21, 0.35)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.28,
                        pointBackgroundColor: '#facc15',
                        pointBorderColor: '#111827',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        const statusCtx = document.getElementById('admin-booking-status-chart');
        if (statusCtx) {
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Confirmed', 'Pending', 'Cancelled', 'Rejected', 'Other'],
                    datasets: [{
                        data: adminStatusData,
                        backgroundColor: ['#16a34a', '#facc15', '#ef4444', '#f97316', '#6b7280'],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                }
            });
        }

        const volumeCtx = document.getElementById('admin-booking-volume-chart');
        if (volumeCtx) {
            new Chart(volumeCtx, {
                type: 'bar',
                data: {
                    labels: adminLabels,
                    datasets: [{
                        label: 'Bookings',
                        data: adminBookingVolumeData,
                        backgroundColor: '#111827',
                        borderColor: '#111827',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    </script>
{% endblock %}
{% endblock %}