{% extends 'admin/base.html.twig' %}

{% block title %}Pending Feedback{% endblock %}

{% block body %}
<div class="space-y-8">
    <section class="p-6 border bg-white">
        <h1 class="text-2xl font-black mb-4">Pending Feedback</h1>

        {% if pending is empty %}
            <div class="text-gray-500">No feedback awaiting approval.</div>
        {% else %}
            <div class="space-y-4">
                {% for fb in pending %}
                    <div class="border p-4 bg-gray-50">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="font-bold">{{ fb.getName() }} <span class="text-xs text-gray-400">({{ fb.getEmail() }})</span></div>
                                <div class="text-xs text-gray-500 mt-1">Submitted: {{ fb.getCreatedAt() ? fb.getCreatedAt().format('Y-m-d H:i') : 'N/A' }}</div>
                            </div>
                            <form method="post" action="{{ path('app_admin_feedback_approve', {'id': fb.getId()}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve-feedback-' ~ fb.getId()) }}">
                                <button class="px-3 py-2 bg-yellow-400 font-black">Approve</button>
                            </form>
                        </div>

                        <div class="mt-4 font-mono text-sm text-gray-700">{{ fb.getContent() }}</div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
