{# templates/admin/roomlisting/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-10'}, 'enctype': 'multipart/form-data'}) }}

<div class="border-b border-black/10 pb-5">
    <p class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 mb-2">Room Configuration</p>
    <h3 class="text-3xl font-black uppercase tracking-tight">{{ button_label|default('Save Room') }}</h3>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="border border-black/10 bg-white p-6 space-y-5">
        <h4 class="text-[11px] font-black uppercase tracking-[0.25em] text-gray-500">Core Details</h4>

        <div class="space-y-2">
            <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">{{ form.category.vars.label }}</label>
            {{ form_widget(form.category, {'attr': {'class': 'block w-full bg-gray-50 border border-black/20 p-3 text-sm font-semibold focus:bg-white focus:outline-none focus:border-black transition-all'}}) }}
            {{ form_errors(form.category) }}
        </div>

        <div class="space-y-2">
            <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">{{ form.number.vars.label }}</label>
            {{ form_widget(form.number, {'attr': {'class': 'block w-full bg-gray-50 border border-black/20 p-3 text-sm font-semibold focus:bg-white focus:outline-none focus:border-black transition-all'}}) }}
            {{ form_errors(form.number) }}
        </div>

        <div class="space-y-2">
            <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">Location</label>
            {{ form_widget(form.location, {'attr': {'class': 'block w-full bg-gray-50 border border-black/20 p-3 text-sm font-semibold focus:bg-white focus:border-black focus:outline-none transition-all', 'placeholder': 'e.g. Makati Central'}}) }}
            {{ form_errors(form.location) }}
        </div>

        <div class="pt-3 border-t border-dashed border-gray-200">
            <div class="flex items-center gap-3">
                {{ form_widget(form.isBlocked, {'attr': {'class': 'h-5 w-5 border-2 border-gray-950 text-yellow-400 focus:ring-0 rounded-none'}}) }}
                <div>
                    <label class="text-[10px] font-black uppercase text-gray-950 block">Mark as unavailable</label>
                    <span class="text-[9px] text-gray-500 uppercase">Hidden from public booking</span>
                </div>
            </div>
        </div>
    </section>

    <section class="border border-black/10 bg-white p-6 space-y-5">
        <h4 class="text-[11px] font-black uppercase tracking-[0.25em] text-gray-500">Pricing and Capacity</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">Price per night</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 font-black text-gray-400 text-sm">₱</span>
                    {{ form_widget(form.pricePerNight, {'attr': {'class': 'block w-full bg-gray-50 border border-black/20 p-3 pl-8 text-sm font-semibold focus:bg-white focus:border-black focus:outline-none transition-all'}}) }}
                </div>
                {{ form_errors(form.pricePerNight) }}
            </div>

            <div class="space-y-2">
                <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">Capacity</label>
                {{ form_widget(form.capacity, {'attr': {'class': 'block w-full bg-gray-50 border border-black/20 p-3 text-sm font-semibold focus:bg-white focus:border-black focus:outline-none transition-all'}}) }}
                {{ form_errors(form.capacity) }}
            </div>
        </div>

        <div class="space-y-2">
            <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">Description</label>
            {{ form_widget(form.description, {'attr': {'rows': 5,'class': 'block w-full bg-gray-50 border border-black/20 p-3 text-sm font-semibold focus:bg-white focus:border-black focus:outline-none transition-all'}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="space-y-2">
            <label class="text-[9px] font-black uppercase tracking-widest text-gray-400">Room image</label>
            <div class="border-2 border-dashed border-gray-300 p-5 bg-gray-50">
                {{ form_widget(form.image, {'attr': {'class': 'text-[10px]'}}) }}
                {{ form_errors(form.image) }}

                {% if form.vars.value.image %}
                    <div class="mt-4 border border-black/10 bg-white p-2 inline-block">
                        <img src="{{ asset(form.vars.value.image matches '/^uploads\\//' ? form.vars.value.image : ('uploads/rooms/' ~ form.vars.value.image)) }}" alt="Current room image" class="h-28 w-44 object-cover">
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
</div>

<div class="pt-8 border-t border-black/10 flex flex-col sm:flex-row justify-end items-center gap-4">
    <a href="{{ path('app_admin_roomlisting_index') }}" class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-red-600 transition-colors">
        Cancel
    </a>

    <button type="submit" class="w-full sm:w-auto bg-yellow-400 border border-black py-3 px-10 text-[11px] font-black uppercase tracking-[0.2em] hover:bg-black hover:text-white transition-colors">
        {{ button_label|default('Save Room') }}
    </button>
</div>

{{ form_end(form) }}