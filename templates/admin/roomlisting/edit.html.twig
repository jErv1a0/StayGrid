{% extends 'admin/base.html.twig' %}

{% block title %}StayGrid // Edit Room {{ room_listing.number }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto py-10 px-4 space-y-8">
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-5">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 mb-2">Admin Roomlisting</p>
            <h1 class="text-4xl font-black uppercase tracking-tight">Edit Room {{ room_listing.number }}</h1>
        </div>
        <a href="{{ path('app_admin_roomlisting_index') }}" class="inline-flex items-center gap-2 bg-white border border-black px-5 py-3 text-[10px] font-black uppercase tracking-[0.2em] hover:bg-yellow-400 transition-colors">
            <i data-feather="arrow-left" class="w-4 h-4"></i>
            Back to Listings
        </a>
    </section>

    <section class="bg-white border border-black/10 p-6 md:p-8">
        {{ include('admin/roomlisting/_form.html.twig', {'button_label': 'Save Changes'}) }}
    </section>

    <section class="border border-red-200 bg-red-50/50 p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-5">
        <div>
            <h4 class="text-[11px] font-black uppercase tracking-widest text-red-600 mb-1">Danger Zone</h4>
            <p class="text-[10px] text-gray-500 uppercase">Deleting this room will permanently remove its listing record.</p>
        </div>
        {{ include('admin/roomlisting/_delete_form.html.twig') }}
    </section>
</div>
{% endblock %}