<form method="POST" 
      action="{{ path('app_admin_roomlisting_delete', {'id': room_listing.id}) }}" 
    onsubmit="return confirm('Are you sure you want to delete this room listing?');" 
      style="display: inline-block;">
    
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ room_listing.id) }}">
    
    <button type="submit" 
            class="group inline-flex items-center gap-2 border border-red-600 bg-white px-3 py-2 text-[10px] font-black uppercase tracking-wider text-red-600 transition-colors hover:bg-red-600 hover:text-white">
        
        <i data-feather="trash-2" class="w-4 h-4 text-red-600 group-hover:text-white transition-colors"></i>
        
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-red-600 group-hover:text-white transition-colors">
            Delete
        </span>
    </button>
</form>