{% extends 'admin/base.html.twig' %}

{% block title %}StayGrid // Inspect_Node_{{ booking.id|slice(0,8) }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-10">
    
    <div class="mb-8 flex items-center justify-between">
        <nav class="flex items-center gap-2 text-[10px] font-mono font-black uppercase tracking-widest text-gray-400">
            <a href="{{ path('app_admin_bookings_index') }}" class="hover:text-yellow-600">Registry</a>
            <i data-feather="chevron-right" class="w-3 h-3"></i>
            <span class="text-gray-950">Node_Inspection</span>
        </nav>
        
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_bookings_edit', {id: booking.id}) }}" class="bg-yellow-400 text-black border border-black px-4 py-2 text-[10px] font-black uppercase tracking-widest hover:bg-black hover:text-white transition-colors">
                Modify_Node
            </a>
            <form method="post" action="{{ path('app_admin_bookings_delete', {id: booking.id}) }}" class="inline" onsubmit="return confirm('PERMANENT DELETION: PROCEED?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-booking-' ~ booking.id) }}">
                <button class="border border-red-600 text-red-600 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-red-600 hover:text-white transition-colors">
                    Purge
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border border-black/10 bg-white">
        
        <div class="bg-[#111827] p-8 lg:border-r lg:border-black/10 text-white">
            <div class="mb-10">
                <p class="text-[9px] font-mono text-gray-500 uppercase tracking-[0.3em] mb-2">Registry_Ref</p>
                <h2 class="text-2xl font-black font-mono break-all text-yellow-400">#{{ booking.id }}</h2>
            </div>

            <div class="space-y-6">
                <div>
                    <p class="text-[9px] font-mono text-gray-500 uppercase tracking-[0.3em] mb-2">Current_Status</p>
                    <span class="inline-block bg-yellow-400 text-black px-3 py-1 text-[11px] font-black uppercase italic">
                        {{ booking.status|default('ACTIVE') }}
                    </span>
                </div>
                <div>
                    <p class="text-[9px] font-mono text-gray-500 uppercase tracking-[0.3em] mb-2">Internal_Priority</p>
                    <p class="text-xs font-bold uppercase text-gray-300">Level_01_Standard</p>
                </div>
            </div>

            <div class="mt-20 pt-10 border-t border-white/10">
                <i data-feather="database" class="w-10 h-10 text-white/10 mb-4"></i>
                <p class="text-[9px] font-mono text-gray-600 uppercase leading-relaxed">
                    This node is encrypted and stored in the primary cluster. Changes are logged to the security audit.
                </p>
            </div>
        </div>

        <div class="lg:col-span-2">
            
            <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-black/10">
                <div class="p-8">
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <i data-feather="home" class="w-3 h-3 text-yellow-500"></i> Unit_Allocation
                    </p>
                    <h4 class="text-xl font-black uppercase text-gray-950">
                        {{ booking.room ? booking.room.getTitle() : '—' }}
                    </h4>
                    <p class="text-xs font-mono text-gray-500 mt-1 uppercase tracking-tighter">
                        Category: {{ booking.room.category|default('Standard') }}
                    </p>
                </div>
                <div class="p-8">
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <i data-feather="user" class="w-3 h-3 text-yellow-500"></i> Guest_Profile
                    </p>
                    <h4 class="text-xl font-black text-gray-950 truncate">
                        {{ booking.user ? booking.user.getEmail() : '—' }}
                    </h4>
                    <p class="text-xs font-mono text-gray-500 mt-1 uppercase tracking-tighter">
                        Verification: SECURE
                    </p>
                </div>
            </div>

            <div class="border-t border-black/10 p-8 bg-gray-50">
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                    <i data-feather="clock" class="w-3 h-3 text-yellow-500"></i> Temporal_Window
                </p>
                
                <div class="flex flex-col md:flex-row items-center justify-between gap-8 bg-white border border-black/10 p-6 relative overflow-hidden">
                    <div class="text-center md:text-left z-10">
                        <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Check_In</p>
                        <p class="text-2xl font-black font-mono text-gray-950">{{ booking.startDate ? booking.startDate|date('Y.m.d') : '—' }}</p>
                    </div>

                    <div class="flex flex-col items-center z-10">
                        <i data-feather="arrow-right" class="w-6 h-6 text-yellow-500"></i>
                        <span class="text-[8px] font-black text-gray-300 uppercase mt-1">Nights: {{ booking.endDate|date('U') - booking.startDate|date('U') > 0 ? (booking.endDate|date('U') - booking.startDate|date('U')) / 86400 : '1' }}</span>
                    </div>

                    <div class="text-center md:text-right z-10">
                        <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Check_Out</p>
                        <p class="text-2xl font-black font-mono text-gray-950">{{ booking.endDate ? booking.endDate|date('Y.m.d') : '—' }}</p>
                    </div>

                    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 10px 10px;"></div>
                </div>
            </div>

            <div class="p-8 border-t border-black/10 flex flex-wrap gap-8">
                <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Sync_Date</p>
                    <p class="text-[11px] font-mono font-bold">{{ "now"|date('M d, Y H:i:s') }}</p>
                </div>
                <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Access_Hash</p>
                    <p class="text-[11px] font-mono font-bold">{{ booking.id|reverse|slice(0, 12)|upper }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8 flex justify-center">
        <a href="{{ path('app_admin_bookings_index') }}" class="text-[10px] font-black uppercase tracking-[0.4em] text-gray-400 hover:text-gray-950 transition-colors">
            Terminate_Inspection_Session
        </a>
    </div>
</div>
{% endblock %}