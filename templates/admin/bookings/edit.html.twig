{% extends 'admin/base.html.twig' %}

{% block title %}StayGrid // Override_Booking_{{ booking.id }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto py-10">

    <div class="mb-6">
        <a href="{{ path('app_admin_bookings_index') }}" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-yellow-600 transition-colors">
            <i data-feather="chevron-left" class="w-3 h-3"></i> Return_to_Registry
        </a>
    </div>

    <div class="bg-white border border-black/10 overflow-hidden">
        
        <div class="bg-[#111827] p-6 flex items-center justify-between border-b border-black/10">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="w-2 h-2 bg-yellow-400"></span>
                    <span class="text-[9px] font-mono font-black text-gray-400 uppercase tracking-widest">Override_Mode_Active</span>
                </div>
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">
                    Booking_Registry <span class="text-yellow-400">#{{ booking.id }}</span>
                </h3>
            </div>
            <div class="text-right">
                <span class="block text-[9px] font-mono text-gray-500 uppercase">Current_Status</span>
                <span class="text-[11px] font-black text-yellow-400 uppercase">{{ booking.status|default('ACTIVE') }}</span>
            </div>
        </div>

        <div class="p-8 lg:p-12">
            
            {% form_theme bookingForm _self %}
            
            {{ form_start(bookingForm, {attr: {class: 'space-y-8'}}) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    
                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <i data-feather="calendar" class="w-3 h-3"></i> {{ form_label(bookingForm.startDate) }}
                        </label>
                        <div class="relative group">
                            {{ form_widget(bookingForm.startDate, {attr: {
                                class: 'w-full bg-gray-50 border border-black/20 p-4 text-sm font-mono font-bold focus:outline-none focus:bg-white focus:border-black transition-all'
                            }}) }}
                        </div>
                        <div class="text-[10px] font-mono text-red-500 uppercase font-bold">
                            {{ form_errors(bookingForm.startDate) }}
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <i data-feather="log-out" class="w-3 h-3"></i> {{ form_label(bookingForm.endDate) }}
                        </label>
                        <div class="relative group">
                            {{ form_widget(bookingForm.endDate, {attr: {
                                class: 'w-full bg-gray-50 border border-black/20 p-4 text-sm font-mono font-bold focus:outline-none focus:bg-white focus:border-black transition-all'
                            }}) }}
                        </div>
                        <div class="text-[10px] font-mono text-red-500 uppercase font-bold">
                            {{ form_errors(bookingForm.endDate) }}
                        </div>
                    </div>

                </div>

                <div class="p-4 bg-gray-50 border border-dashed border-gray-300">
                    <p class="text-[10px] leading-relaxed text-gray-500 font-mono uppercase">
                        <span class="font-black text-gray-950">[WARNING]</span> Changing dates may cause availability conflicts in Node_Inventory. System will validate changes upon submission.
                    </p>
                </div>

                <div class="pt-6 flex flex-col sm:flex-row items-center gap-6">
                    <button type="submit" class="w-full sm:w-auto bg-yellow-400 border border-black px-10 py-4 text-[11px] font-black uppercase tracking-[0.2em] hover:bg-black hover:text-white transition-colors">
                        Commit_Changes
                    </button>
                    
                    <a href="{{ path('app_admin_bookings_index') }}" class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-red-600 transition-colors">
                        Discard_Edits
                    </a>
                </div>

            {{ form_end(bookingForm) }}
        </div>

        <div class="bg-gray-50 border-t border-black/10 px-8 py-4 flex justify-between items-center">
            <span class="text-[9px] font-mono text-gray-400 uppercase tracking-tighter">Auth_Session: {{ app.user.userIdentifier }}</span>
            <span class="text-[9px] font-mono text-gray-400 uppercase tracking-tighter">Ref_UID: {{ booking.id|reverse|slice(0, 8) }}</span>
        </div>
    </div>
</div>
{% endblock %}