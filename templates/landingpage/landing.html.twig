    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f7f9fc;
        }
        .nav-link { color: #4b5563; }
        .nav-link:hover { color: #FFD700; transition: color 0.3s ease; }
        .btn-primary { background-color: #FFD700; border-color: #FFD700; }
        .btn-primary:hover { background-color: #e6c200; }

        /* Reusable design system animations */
        .card-hover { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .card-hover:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(255,215,0,0.15); }
        
        .slide-up { animation: slideUp 0.6s ease-out; }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pulse-glow { animation: pulseGlow 2s ease-in-out infinite; }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255,215,0,0.7); }
            50% { box-shadow: 0 0 0 10px rgba(255,215,0,0); }
        }

        .gradient-text { background: linear-gradient(135deg, #FFD700 0%, #FFC700 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

        /* Popup animation */
        .fade-in-out {
            animation: fadeInOut 10s forwards;
        }

        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(-20px); }
            10% { opacity: 1; transform: translateY(0); }
            90% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-20px); }
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            animation: heroSlideFade 20s infinite;
        }

        .hero-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.02);
        }

        @keyframes heroSlideFade {
            0% { opacity: 0; transform: scale(1.01); }
            4% { opacity: 1; transform: scale(1.03); }
            20% { opacity: 1; transform: scale(1.05); }
            25% { opacity: 0; transform: scale(1.06); }
            100% { opacity: 0; transform: scale(1.06); }
        }
    </style>
</head>
