<!DOCTYPE html>

<html lang="en">
<head>
    {% include 'partials/_global_radius.html.twig' %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{% block title %}{{ page_title|default("StayGrid") }}{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('icons/staygrid16x16.png') }}"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="//unpkg.com/alpinejs" defer></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fc;
        }
        .nav-link { color: #4b5563; }
        .nav-link:hover { color: #FFD700; }
        .btn-primary { background-color: #FFD700; border-color: #FFD700; }
        .btn-primary:hover { background-color: #e6c200; }
        .feature-icon-bg { background-color: #FFF4B0; color: #FFD700; }
        
        /* Button radius controlled by included partial: templates/partials/_global_radius.html.twig */

    {% block styles %}{% endblock %} 

</style>

</head>
<body>

    </div>

    <nav class="bg-white shadow-sm sticky top-0 z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="flex items-center space-x-2 text-xl font-bold text-gray-800">
                    StayGrid
                </a>

                <div class="hidden md:flex space-x-6 items-center">
                    {% set nav_items = [
                        { name: 'Home', url: '/' },
                        { name: 'Rooms', url: '/rooms' },
                        { name: 'About', url: '/about' },
                        { name: 'Contact', url: '/contact' }
                    ] %}
                    {% for item in nav_items %}
                        <a href="{{ item.url }}" class="nav-link text-sm font-medium flex items-center">
                            {{ item.name }}
                        </a>
                    {% endfor %}
                </div>

                <div class="hidden md:flex items-center gap-3">
                    {% if app.user %}
                        <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admin_home' : (is_granted('ROLE_STAFF') ? 'app_staff_dashboard' : 'app_user_dashboard')) }}"
                           class="bg-black hover:bg-gray-800 text-white font-bold py-2 px-5 rounded-lg shadow-lg transition duration-200">
                            Dashboard
                        </a>
                        <a href="{{ path('app_logout') }}"
                           class="border border-gray-300 hover:border-gray-400 text-gray-700 hover:text-black font-semibold py-2 px-5 rounded-lg transition duration-200">
                            Log Out
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}"
                           class="border border-gray-300 hover:border-gray-400 text-gray-700 hover:text-black font-semibold py-2 px-5 rounded-lg transition duration-200">
                            Log In
                        </a>
                        <a href="{{ path('app_register') }}"
                           class="bg-yellow-400 hover:bg-yellow-500 text-black font-bold py-2 px-6 rounded-lg shadow-lg transition duration-200">
                            Sign Up
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

      <main>
          {# 🛑 CRITICAL FIX: The missing content block was preventing child templates from rendering their body content. #}
          {% block content %}{# All page-specific content will be rendered here #}{% endblock %}
      </main>
      
       <footer> 
            {% block footer %}{# Add your footer content here #}{% endblock %}
       </footer> 

    </body>
</html>
