{% extends 'staff/base.html.twig' %}

{% block title %}StayGrid // BOOKING_LEDGER{% endblock %}

{% block body %}
<div class="space-y-8">
    <header class="bg-[#0b0c10] text-white border border-black/10 p-7 md:p-9">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2 py-0.5 bg-yellow-400 text-black text-[9px] font-black uppercase tracking-widest">Live Registry</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight">Bookings.</h1>
            </div>
            <a href="{{ path('app_staff_roomlisting_index') }}" class="bg-white text-black px-6 py-3 text-[10px] font-black uppercase tracking-[0.2em] hover:bg-yellow-400 transition-colors self-start md:self-auto">Return to Inventory</a>
        </div>
    </header>

    <div class="border border-black/10 bg-white overflow-hidden">
        {% if bookings is not empty %}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-[#111827] text-white text-[9px] font-black uppercase tracking-widest">
                        <tr>
                            <th class="px-6 py-4">ID</th>
                            <th class="px-6 py-4">Unit</th>
                            <th class="px-6 py-4">Occupant</th>
                            <th class="px-6 py-4">Timeline</th>
                            <th class="px-6 py-4 text-right">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/10">
                        {% for booking in bookings %}
                            <tr class="hover:bg-gray-50 transition-colors text-[11px]">
                                <td class="px-6 py-4 font-mono text-gray-400">#{{ booking.id }}</td>
                                <td class="px-6 py-4 font-black uppercase text-gray-950">{{ booking.room ? booking.room.title : 'Unallocated' }}</td>
                                <td class="px-6 py-4 text-gray-600 uppercase">{{ booking.user ? booking.user.email : 'Guest' }}</td>
                                <td class="px-6 py-4 font-black text-gray-500 uppercase">{{ booking.startDate ? booking.startDate|date('d.M.y') : '--' }} &rarr; {{ booking.endDate ? booking.endDate|date('d.M.y') : '--' }}</td>
                                <td class="px-6 py-4 text-right">
                                    <span class="inline-block px-2 py-1 text-[9px] font-black uppercase tracking-widest border {% if booking.status == 'confirmed' %}border-green-500 text-green-600{% else %}border-yellow-500 text-yellow-600{% endif %}">{{ booking.status }}</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-4">
                                        <a href="{{ path('app_staff_booking_edit', {id: booking.id}) }}" class="text-[10px] font-black uppercase tracking-widest text-black border-b border-black">Edit</a>
                                        <form method="post" action="{{ path('app_staff_booking_delete', {id: booking.id}) }}" onsubmit="return confirm('Confirm Deletion?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-booking-' ~ booking.id) }}">
                                            <button class="text-[10px] font-black uppercase tracking-widest text-red-300 hover:text-red-600 transition-colors italic">Purge</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="py-24 text-center border-2 border-dashed border-gray-200">
                <p class="text-[10px] font-black uppercase tracking-[0.5em] text-gray-300 italic">Registry_Void // No_Active_Bookings</p>
            </div>
        {% endif %}
    </div>

    <footer class="flex justify-between items-center text-[9px] font-mono text-gray-400 uppercase tracking-widest">
        <span>Displaying {{ bookings|length }} Log Entries</span>
        <span>StayGrid Staff Auth</span>
    </footer>
</div>
{% endblock %}
