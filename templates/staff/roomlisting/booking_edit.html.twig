{% extends 'staff/base.html.twig' %}

{% block title %}StayGrid // OVERRIDE_{{ booking.id }}{% endblock %}

{% block body %}
{# --- ERROR MODAL FOR DUPLICATE BOOKINGS --- #}
{% if duplicate_booking_error is defined and duplicate_booking_error %}
<div id="errorModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 backdrop-blur-sm">
    <div class="bg-white rounded-lg shadow-2xl max-w-md w-full mx-4 p-8 border-l-4 border-red-500 animate-in fade-in duration-300">
        <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="flex-1">
                <h3 class="text-lg font-black uppercase tracking-tight text-gray-900 mb-2">
                    Booking_Error
                </h3>
                <p class="text-sm text-gray-600 font-light leading-relaxed italic">
                    {{ duplicate_booking_error }}
                </p>
                <div class="mt-6">
                    <p class="text-[10px] text-gray-400 uppercase font-mono tracking-widest mb-4">
                        Reference: SG-{{ "now"|date("Ymdhis") }}
                    </p>
                    <button onclick="closeErrorModal()" class="w-full bg-red-500 hover:bg-red-600 text-white font-black uppercase text-sm py-3 px-4 transition-colors duration-200 tracking-wide">
                        Acknowledge_Error
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function closeErrorModal() {
        document.getElementById('errorModal').style.display = 'none';
    }
</script>
{% endif %}

<section class="min-h-screen bg-grid-gray flex flex-col font-sans antialiased">
    
    {# --- TOP NAV: SYSTEM STATUS --- #}
    <div class="px-8 py-6 flex justify-between items-center border-b-4 border-grid-black bg-white sticky top-0 z-50">
        <div class="flex items-center gap-6">
            <span class="text-[10px] font-black uppercase tracking-[0.5em] text-yellow-500">Manual_Override</span>
            <div class="h-4 w-px bg-gray-100"></div>
            <span class="text-[10px] font-mono text-gray-300 uppercase tracking-widest">Ref_Node: {{ booking.id }}</span>
        </div>
        <a href="{{ path('app_staff_booking_show', {id: booking.id}) }}" 
           class="group flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 hover:text-black transition-all">
            <i data-feather="arrow-left" class="w-3 h-3 transition-transform group-hover:-translate-x-1"></i>
            Exit_Editor
        </a>
    </div>

    <div class="flex-1 max-w-7xl mx-auto w-full grid lg:grid-cols-12 gap-0">
        
        {# --- LEFT SIDE: THE CONTEXT PANEL --- #}
        <div class="lg:col-span-5 p-8 lg:p-20 border-r border-gray-100 flex flex-col justify-center bg-white">
            <div class="mb-16">
                <h1 class="text-[100px] md:text-[120px] font-black text-gray-950 leading-[0.8] tracking-tighter uppercase mb-8 italic">
                    Edit<br/>
                    <span class="text-transparent" style="-webkit-text-stroke: 1px #d1d5db;">Node.</span>
                </h1>
                <div class="space-y-4">
                    <p class="max-w-xs text-[10px] font-black text-gray-900 uppercase tracking-widest">
                        Target: {{ booking.roomListing.title|default('Executive Suite') }}
                    </p>
                    <p class="max-w-xs text-xs font-medium text-gray-400 uppercase leading-relaxed tracking-tight italic">
                        All temporal adjustments will trigger an immediate inventory re-synchronization across the global grid.
                    </p>
                </div>
            </div>

            <div class="relative p-10 bg-gray-950 text-white shadow-[0_30px_60px_-15px_rgba(0,0,0,0.3)]">
                <span class="absolute -right-2 -top-10 text-white/5 text-[10rem] font-black italic pointer-events-none">!</span>
                <p class="relative z-10 text-[9px] font-black uppercase tracking-[0.4em] text-yellow-400 mb-4">Warning_Protocol</p>
                <p class="relative z-10 text-xs font-bold leading-tight uppercase italic text-gray-300">
                    Temporal shifts force pricing recalculations. Verify financial clearance before committing.
                </p>
            </div>
        </div>

        {# --- RIGHT SIDE: THE CORE EDITOR --- #}
        <div class="lg:col-span-7 bg-[#FBFBFB] p-8 lg:p-24 flex flex-col justify-center">
            {{ form_start(bookingForm, {'attr': {'class': 'space-y-16 editorial-form'}}) }}
                
                {# Start Date #}
                <div class="group border-b border-gray-200 focus-within:border-gray-950 transition-all pb-4">
                    {{ form_label(bookingForm.startDate, '01_Entry_Date', {'label_attr': {'class': 'label-style'}}) }}
                    {{ form_widget(bookingForm.startDate, {'attr': {'class': 'input-reset'}}) }}
                    {{ form_errors(bookingForm.startDate) }}
                </div>

                {# End Date #}
                <div class="group border-b border-gray-200 focus-within:border-gray-950 transition-all pb-4">
                    {{ form_label(bookingForm.endDate, '02_Exit_Date', {'label_attr': {'class': 'label-style'}}) }}
                    {{ form_widget(bookingForm.endDate, {'attr': {'class': 'input-reset'}}) }}
                    {{ form_errors(bookingForm.endDate) }}
                </div>

                {# Status #}
                <div class="group border-b border-gray-200 focus-within:border-gray-950 transition-all pb-4">
                    {{ form_label(bookingForm.status, '03_Lifecycle_Status', {'label_attr': {'class': 'label-style'}}) }}
                    {{ form_widget(bookingForm.status, {'attr': {'class': 'input-reset appearance-none'}}) }}
                    {{ form_errors(bookingForm.status) }}
                </div>

                {# --- CALENDAR: AVAILABILITY VISUALIZATION --- #}
                <div class="pt-8 bg-gray-50 p-6 border border-gray-200">
                    <p class="text-[9px] font-black uppercase tracking-[0.3em] text-gray-400 italic mb-4">Availability_Calendar</p>
                    <div id="calendar" class="grid grid-cols-7 gap-2">
                        <!-- Calendar will be generated by JavaScript -->
                    </div>
                </div>

                <div class="pt-4 flex items-center gap-4 text-[9px] font-mono uppercase tracking-widest">
                    <div class="flex items-center gap-2">
                        <div class="w-4 h-4 bg-green-100 border border-green-400"></div>
                        <span class="text-gray-600">Available</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-4 h-4 bg-red-100 border border-red-500 line-through"></div>
                        <span class="text-gray-600">Booked</span>
                    </div>
                </div>

                {# Submit Area #}
                <div class="pt-10 flex flex-col md:flex-row items-center justify-between gap-8">
                    {{ form_rest(bookingForm) }}
                    <button type="submit" 
                            class="w-full md:w-auto bg-gray-950 text-white px-14 py-7 text-[10px] font-black uppercase tracking-[0.4em] hover:bg-yellow-400 hover:text-gray-950 transition-all shadow-xl shadow-black/10 active:scale-95">
                        Commit_Sync
                    </button>
                    
                    <div class="text-right border-l border-gray-100 pl-8">
                        <p class="text-[8px] font-mono text-gray-400 uppercase leading-tight tracking-widest">
                            Authorized_By: {{ app.user.email|default('OPERATOR_X')|slice(0, 15) }}...<br/>
                            Access_Level: Level_01_Staff
                        </p>
                    </div>
                </div>
            {{ form_end(bookingForm) }}
        </div>
    </div>
</section>

<style>
    /* These specific overrides kill the "ugly" browser defaults */
    .label-style {
        @apply block text-[9px] font-black uppercase tracking-[0.4em] text-gray-400 group-focus-within:text-yellow-500 transition-colors mb-2;
    }
    
    .input-reset {
        @apply w-full bg-transparent border-none p-0 text-3xl font-black uppercase tracking-tighter focus:ring-0 cursor-pointer text-gray-950;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
    }

    /* Target standard Symfony error lists */
    .editorial-form ul {
        @apply mt-2 text-red-500 text-[10px] font-bold uppercase italic list-none p-0;
    }

    /* Date input specific fix for Chrome/Safari */
    input[type="date"]::-webkit-calendar-picker-indicator {
        @apply opacity-20 hover:opacity-100 transition-opacity cursor-pointer;
        filter: invert(0);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const bookedDatesString = '{{ bookedDates is defined ? bookedDates : "[]" | raw }}';
    const bookedDates = JSON.parse(bookedDatesString);
    const calendar = document.getElementById('calendar');
    const startDateInput = document.querySelector('[id$="_startDate"]');
    const endDateInput = document.querySelector('[id$="_endDate"]');
    
    if (!calendar) return;
    
    // Generate calendar for next 60 days
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    for (let i = 0; i < 60; i++) {
        const date = new Date(today);
        date.setDate(date.getDate() + i);
        const dateStr = date.toISOString().split('T')[0];
        
        const dayDiv = document.createElement('div');
        dayDiv.className = 'p-2 text-center text-[9px] font-mono font-bold border cursor-pointer rounded transition-all';
        dayDiv.textContent = date.getDate();
        dayDiv.title = dateStr;
        
        if (bookedDates.includes(dateStr)) {
            dayDiv.className += ' bg-red-100 border-red-500 line-through text-red-700';
            dayDiv.style.opacity = '0.6';
        } else {
            dayDiv.className += ' bg-green-50 border-green-300 text-green-700 hover:bg-green-200';
            dayDiv.addEventListener('click', function() {
                if (!startDateInput.value) {
                    startDateInput.value = dateStr;
                } else if (!endDateInput.value) {
                    if (new Date(dateStr) > new Date(startDateInput.value)) {
                        endDateInput.value = dateStr;
                    } else {
                        startDateInput.value = dateStr;
                        endDateInput.value = '';
                    }
                } else {
                    startDateInput.value = dateStr;
                    endDateInput.value = '';
                }
            });
        }
        
        calendar.appendChild(dayDiv);
    }
});
</script>
{% endblock %}