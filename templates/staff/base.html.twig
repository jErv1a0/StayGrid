{# templates/staff/base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    {% include 'partials/_global_radius.html.twig' %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}StayGrid Staff{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('icons/staygrid16x16.png') }}"/>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:ital,wght@0,400;0,800;1,400&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    },
                    colors: {
                        'grid-yellow': '#facc15',
                        'grid-black': '#0a0a0a',
                        'grid-gray': '#f4f4f5'
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #0a0a0a; }
        ::-webkit-scrollbar-thumb { background: #ffd700; border: 2px solid #0a0a0a; }
        body { font-family: 'Manrope', sans-serif; cursor: crosshair; }
        .sidebar-link-active {
            background-color: #ffd700 !important;
            color: #0a0a0a !important;
            border-right: 8px solid #0a0a0a;
            font-weight: 900;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-grid-gray text-grid-black min-h-screen flex overflow-x-hidden">
    {% set current_route = app.request ? (app.request.attributes.get('_route') ?: '') : '' %}
    {% set current_user = app.user %}

    {% block sidebar %}
    <aside id="staff-sidebar" class="w-64 max-w-[85vw] bg-grid-black text-white z-50 fixed inset-y-0 left-0 min-h-screen border-r-4 border-grid-black flex flex-col sidebar-transition -translate-x-full lg:translate-x-0">
        <div class="p-6 border-b border-white/10">
            <div class="flex items-start justify-between gap-4">
                <h2 class="text-2xl font-black tracking-tighter italic">
                    STAY<span class="text-grid-yellow">GRID</span>
                    <span class="block text-[8px] font-mono tracking-[0.4em] text-gray-500 uppercase mt-1">Staff_Terminal_v4.0</span>
                </h2>
                <button id="close-sidebar" class="lg:hidden text-white/50 hover:text-white shrink-0" aria-label="Close menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <nav class="flex-1 flex flex-col mt-4">
            <a href="{{ path('app_staff_dashboard') }}"
               class="flex items-center px-6 py-4 text-[11px] font-black uppercase tracking-widest transition-all hover:bg-white/5 hover:pl-8 group {{ current_route == 'app_staff_dashboard' ? 'sidebar-link-active' : '' }}">
                <i data-feather="grid" class="w-4 h-4 mr-3 {{ current_route == 'app_staff_dashboard' ? 'text-grid-black' : 'text-grid-yellow' }}"></i>
                Dashboard
            </a>
            <a href="{{ path('app_staff_roomlisting_index') }}"
               class="flex items-center px-6 py-4 text-[11px] font-black uppercase tracking-widest transition-all hover:bg-white/5 hover:pl-8 group {{ current_route starts with 'app_staff_roomlisting' ? 'sidebar-link-active' : '' }}">
                <i data-feather="box" class="w-4 h-4 mr-3 {{ current_route starts with 'app_staff_roomlisting' ? 'text-grid-black' : 'text-grid-yellow' }}"></i>
                Roomlisting
            </a>
            <a href="{{ path('app_staff_roomlisting_bookings') }}"
               class="flex items-center px-6 py-4 text-[11px] font-black uppercase tracking-widest transition-all hover:bg-white/5 hover:pl-8 group {{ 'booking' in current_route or 'bookings' in current_route ? 'sidebar-link-active' : '' }}">
                <i data-feather="calendar" class="w-4 h-4 mr-3 {{ 'booking' in current_route or 'bookings' in current_route ? 'text-grid-black' : 'text-grid-yellow' }}"></i>
                Booking
            </a>
                <a href="{{ path('app_staff_users_index') }}"
                    class="flex items-center px-6 py-4 text-[11px] font-black uppercase tracking-widest transition-all hover:bg-white/5 hover:pl-8 group {{ current_route starts with 'app_staff_users' ? 'sidebar-link-active' : '' }}">
                     <i data-feather="users" class="w-4 h-4 mr-3 {{ current_route starts with 'app_staff_users' ? 'text-grid-black' : 'text-grid-yellow' }}"></i>
                     Users
                </a>
            <a href="{{ path('app_staff_profile_edit') }}"
               class="flex items-center px-6 py-4 text-[11px] font-black uppercase tracking-widest transition-all hover:bg-white/5 hover:pl-8 group {{ current_route starts with 'app_staff_profile' ? 'sidebar-link-active' : '' }}">
                <i data-feather="user" class="w-4 h-4 mr-3 {{ current_route starts with 'app_staff_profile' ? 'text-grid-black' : 'text-grid-yellow' }}"></i>
                Profile
            </a>
            <div class="mt-auto border-t-2 border-white/10 p-6">
                <div class="flex items-center text-[10px] font-mono text-gray-400 hover:text-white mb-4 italic uppercase">
                    <i data-feather="user" class="w-3 h-3 mr-2"></i> {{ current_user.email|default('Operator') }}
                </div>
                <a href="{{ path('app_logout') }}"
                   onclick="event.preventDefault(); document.getElementById('logout-form').submit();"
                   class="block w-full text-center border-2 border-grid-yellow text-grid-yellow py-2 text-[10px] font-black uppercase tracking-widest hover:bg-grid-yellow hover:text-grid-black transition-all">
                    Term_Session
                </a>
                <form id="logout-form" action="{{ path('app_logout') }}" method="POST" class="hidden">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                </form>
            </div>
        </nav>
    </aside>
    {% endblock %}

    <div id="staff-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

    <main class="flex-1 lg:ml-64 flex flex-col min-h-screen min-w-0">
        <header class="bg-white border-b-4 border-grid-black py-4 px-8 sticky top-0 z-10 flex justify-between items-center gap-6">
            <button id="open-sidebar" class="lg:hidden p-2 -ml-2 text-grid-black" aria-label="Open menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16m-7 6h7" stroke-width="2"></path></svg>
            </button>
            <h1 class="text-sm font-black text-grid-black uppercase tracking-[0.3em]">
                {% block header_title %}System Overview{% endblock %}
            </h1>
            <div class="relative w-full max-w-xs">
                <input type="text" placeholder="QUERY_SYSTEM..."
                       class="w-full pl-10 pr-4 py-2 bg-grid-gray border-2 border-grid-black text-xs font-mono focus:outline-none focus:bg-grid-yellow/10 transition-colors">
                <i data-feather="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-grid-black"></i>
            </div>
        </header>

        <div class="p-8">
            {% block body %}{% endblock %}
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            const sidebar = document.getElementById('staff-sidebar');
            const backdrop = document.getElementById('staff-backdrop');
            const openBtn = document.getElementById('open-sidebar');
            const closeBtn = document.getElementById('close-sidebar');

            const setSidebarOpen = (isOpen) => {
                sidebar?.classList.toggle('-translate-x-full', !isOpen);
                backdrop?.classList.toggle('hidden', !isOpen);
            };

            openBtn?.addEventListener('click', () => setSidebarOpen(true));
            closeBtn?.addEventListener('click', () => setSidebarOpen(false));
            backdrop?.addEventListener('click', () => setSidebarOpen(false));
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
