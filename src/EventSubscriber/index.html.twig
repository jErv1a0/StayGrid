<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Rooms | StayGrid</title>
    <link rel="icon" type="image/png" href="{{ asset('icons/staygrid16x16.png') }}"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .glass-header { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="text-gray-800 antialiased">

    {# --- Navigation --- #}
    <nav class="glass-header border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-2xl font-bold text-gray-900 tracking-tight">StayGrid</span>
                </a>

                <div class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-gray-600 hover:text-yellow-500 font-medium transition">Home</a>
                    <a href="/rooms" class="text-yellow-500 font-bold transition">Rooms</a>
                    <a href="/about" class="text-gray-600 hover:text-yellow-500 font-medium transition">About</a>
                    <a href="/contact" class="text-gray-600 hover:text-yellow-500 font-medium transition">Contact</a>
                </div>

                <div class="flex items-center gap-4">
                    {% if app.user %}
                        <a href="{{ path('app_logout') }}" class="text-sm font-semibold text-gray-500 hover:text-gray-800">Log Out</a>
                        <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admin_home' : 'app_user_dashboard') }}" class="bg-gray-900 text-white px-5 py-2.5 rounded-full font-medium hover:bg-gray-800 transition shadow-lg shadow-gray-200">
                            Dashboard
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm font-semibold text-gray-500 hover:text-gray-800">Log In</a>
                        <a href="{{ path('app_register') }}" class="bg-yellow-400 text-gray-900 px-5 py-2.5 rounded-full font-bold hover:bg-yellow-300 transition shadow-lg shadow-yellow-100">
                            Sign Up
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    {# --- Hero Section --- #}
    <header class="relative bg-gray-900 py-24 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-[url('https://images.unsplash.com/photo-1618773928121-c32242e63f39?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
        
        <div class="relative z-10 max-w-4xl mx-auto px-6">
            <span class="text-yellow-400 font-semibold tracking-wider uppercase text-sm mb-4 block">Premium Accommodation</span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
                Curated Rooms for <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-500">Exceptional Stays</span>
            </h1>
            <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">
                Discover spaces designed for modern living. Smart features, secure access, and comfort guaranteed.
            </p>
        </div>
    </header>

    {# --- Search / Filter Bar --- #}
    <div class="relative z-20 -mt-10 max-w-6xl mx-auto px-4">
        <div class="bg-white rounded-2xl shadow-xl p-4 grid grid-cols-1 md:grid-cols-4 gap-4 items-end border border-gray-100">
            <div class="space-y-1">
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wide ml-1">Location / Category</label>
                <select class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-yellow-400 outline-none transition">
                    <option>All Categories</option>
                    <option>Deluxe Suite</option>
                    <option>Standard Room</option>
                    <option>Economy</option>
                </select>
            </div>
            <div class="space-y-1">
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wide ml-1">Check In</label>
                <input type="date" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-yellow-400 outline-none transition">
            </div>
             <div class="space-y-1">
                <label class="text-xs font-bold text-gray-400 uppercase tracking-wide ml-1">Check Out</label>
                <input type="date" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-yellow-400 outline-none transition">
            </div>
            <button class="bg-gray-900 hover:bg-gray-800 text-white font-bold py-3.5 rounded-xl transition shadow-lg">
                Search Availability
            </button>
        </div>
    </div>

    {# --- Rooms Grid --- #}
    <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
            <div>
                <h2 class="text-3xl font-bold text-gray-900">Available Rooms</h2>
                <p class="text-gray-500 mt-2">Explore our most popular choices.</p>
            </div>
            <div class="hidden md:flex gap-2">
                <button class="px-4 py-2 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition font-medium text-sm">Lowest Price</button>
                <button class="px-4 py-2 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition font-medium text-sm">Best Rated</button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for room in rooms %}
                <div class="group bg-white rounded-3xl p-3 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition duration-300 border border-gray-100">
                    <div class="relative h-64 rounded-2xl overflow-hidden mb-4 bg-gray-100">
                        {% set imagePath = room.imagePath ?: null %}
                        {% if imagePath %}
                            <img src="{{ asset(imagePath) }}" alt="{{ room.category }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1974&auto=format&fit=crop" alt="Room Placeholder" class="w-full h-full object-cover group-hover:scale-105 transition duration-500 grayscale opacity-80">
                        {% endif %}
                        
                        <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-gray-900 shadow-sm border border-white/50">
                            {{ room.category|default('Standard') }}
                        </div>
                    </div>
                    
                    <div class="px-2 pb-2">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-bold text-gray-900">
                                {{ room.category }} <span class="text-gray-400 font-normal text-base">#{{ room.number }}</span>
                            </h3>
                        </div>
                        <p class="text-gray-500 text-sm line-clamp-2 mb-4 h-10">{{ room.description }}</p>
                        
                        <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
                            <span class="flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> {{ room.capacity }} Guests</span>
                            <span class="flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Smart TV</span>
                        </div>

                        <div class="flex items-center justify-between pt-4 border-t border-dashed border-gray-200">
                            <div>
                                <span class="block text-xs text-gray-400 uppercase font-bold">Price</span>
                                <span class="text-2xl font-bold text-gray-900">${{ room.pricePerNight }}</span>
                            </div>
                            <a href="#" class="bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-bold py-2.5 px-6 rounded-xl transition shadow-sm">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-span-3 text-center py-20 bg-white rounded-3xl border border-dashed border-gray-200">
                    <p class="text-gray-500 text-lg">No rooms available at the moment.</p>
                </div>
            {% endfor %}
        </div>
    </section>

    {# --- Why Choose Us Section --- #}
    <section class="bg-white border-t border-gray-100 py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Why Choose StayGrid?</h2>
                <p class="text-gray-500">We redefine hospitality by merging technology with comfort. Here is why thousands of travelers prefer us.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                <div class="text-center p-6 rounded-2xl hover:bg-gray-50 transition duration-300">
                    <div class="w-16 h-16 bg-yellow-100 rounded-2xl flex items-center justify-center text-yellow-600 mx-auto mb-6">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Smart & Secure</h3>
                    <p class="text-gray-500 leading-relaxed">Keyless entry, voice-controlled ambiance, and 24/7 automated security monitoring.</p>
                </div>
                <div class="text-center p-6 rounded-2xl hover:bg-gray-50 transition duration-300">
                    <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600 mx-auto mb-6">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Best Price Guarantee</h3>
                    <p class="text-gray-500 leading-relaxed">Direct booking ensures you get the lowest rates with no hidden fees or commissions.</p>
                </div>
                <div class="text-center p-6 rounded-2xl hover:bg-gray-50 transition duration-300">
                    <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center text-green-600 mx-auto mb-6">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">24/7 Digital Support</h3>
                    <p class="text-gray-500 leading-relaxed">Instant assistance via our app. Request housekeeping or amenities with a single tap.</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-gray-900 py-12 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-gray-500 text-sm">&copy; {{ 'now'|date('Y') }} StayGrid Inc. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
